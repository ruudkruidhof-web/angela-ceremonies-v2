---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  darkHero?: boolean;
}

const { title, description, canonical = Astro.url.pathname, ogImage = '/og/home.jpg', jsonLd, darkHero = false } = Astro.props;
const canonicalURL = new URL(canonical, Astro.site ?? Astro.url.origin).href;
const ogURL = new URL(ogImage, Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#f6f1e7" />
    <meta name="author" content={site.persoon} />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sacramento&display=swap" />

    <ClientRouter fallback="swap" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={site.naam} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogURL} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Klantdashboard meetscript — plak hier het exacte snippet van de Sites-pagina (app.haagsebrandmerk.nl) */}
    {/* <script defer src="DASHBOARD_MEETSCRIPT_URL"></script> */}

    {/* CMS preview-brug */}
    <script src="https://cms-denhaag.vercel.app/preview-bridge.js" defer></script>
  </head>
  <body>
    <a href="#main" class="visually-hidden">Naar de inhoud</a>
    <Nav forceSolid={!darkHero} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a class="wa-float" href={site.whatsapp} target="_blank" rel="noopener" aria-label="Stuur Angela een WhatsApp" data-hb-goal="whatsapp">
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M16 3C9 3 3.4 8.6 3.4 15.6c0 2.5.7 4.8 1.9 6.8L3 29l6.8-2.2c1.9 1 4 1.6 6.2 1.6 7 0 12.6-5.6 12.6-12.6S23 3 16 3Zm0 22.9c-2 0-3.9-.5-5.5-1.5l-.4-.2-4 1.3 1.3-3.9-.3-.4a10.2 10.2 0 0 1-1.6-5.5C5.5 9.8 10.2 5.1 16 5.1S26.5 9.8 26.5 15.6 21.8 25.9 16 25.9Zm5.8-7.7c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2c-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.3.3-.5.1-.2.1-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.3 5.2 4.6.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.9-.8 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/>
      </svg>
    </a>

    <style>
      .wa-float {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 55;
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #25d366;
        color: #fff;
        box-shadow: 0 8px 24px -6px hsl(140 60% 20% / 0.5);
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .wa-float:hover { transform: translateY(-3px) scale(1.05); }
      @media (max-width: 880px) { .wa-float { width: 50px; height: 50px; right: 1rem; bottom: 1rem; } }
    </style>

    {/* Cookie-consent — Google Analytics laadt pas na akkoord, naast cookieloze Vercel Web Analytics */}
    <div class="cookie" data-cookie hidden>
      <p>Wij gebruiken cookieloze statistieken en, met jouw akkoord, Google Analytics om de site te verbeteren.</p>
      <div class="cookie-actions">
        <button type="button" data-cookie-decline class="cookie-btn ghost">Alleen noodzakelijk</button>
        <button type="button" data-cookie-accept class="cookie-btn">Akkoord</button>
      </div>
    </div>

    <style>
      .cookie[hidden] { display: none; }
      .cookie {
        position: fixed;
        left: 1.25rem;
        bottom: 1.25rem;
        z-index: 60;
        width: min(400px, calc(100vw - 2rem));
        animation: cookie-rise 0.6s 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
        background: var(--white);
        border: 1px solid var(--line);
        box-shadow: var(--shadow-lift);
        border-radius: 4px;
        padding: 1.1rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.9rem;
      }
      .cookie p { font-size: 0.82rem; line-height: 1.6; color: var(--muted); margin: 0; }
      .cookie-actions { display: flex; gap: 0.6rem; align-self: stretch; }
      .cookie-actions .cookie-btn { flex: 1; text-align: center; }
      .cookie-btn {
        font-family: var(--font-body);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.6rem 1rem;
        border-radius: 2px;
        cursor: pointer;
        border: 1px solid var(--brown);
        background: var(--brown);
        color: var(--cream);
      }
      .cookie-btn.ghost { background: transparent; color: var(--brown); border-color: var(--line); }
      .cookie-btn:hover { filter: brightness(1.08); }
      @keyframes cookie-rise { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: translateY(0); } }
      @media (prefers-reduced-motion: reduce) { .cookie { animation: none; } }
    </style>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // Re-initialised on every page load AND after each View Transition swap.
      const GA_ID = ''; // TODO: vul Google Analytics ID in (G-XXXXXXX)

      let revealMM: ReturnType<typeof gsap.matchMedia> | undefined;

      function initReveal() {
        revealMM?.revert();
        revealMM = gsap.matchMedia();

        revealMM.add('(prefers-reduced-motion: no-preference)', () => {
          const batch = ScrollTrigger.batch('.reveal', {
            start: 'top 88%',
            once: true,
            onEnter: (els) =>
              gsap.to(els, { opacity: 1, y: 0, duration: 1, ease: 'power3.out', stagger: 0.12, overwrite: true }),
          });
          const rules = ScrollTrigger.batch('.reveal-rule', {
            start: 'top 90%',
            once: true,
            onEnter: (els) => gsap.to(els, { scaleX: 1, duration: 1.1, ease: 'power3.out', overwrite: true }),
          });
          return () => {
            batch.forEach((t) => t.kill());
            rules.forEach((t) => t.kill());
          };
        });

        revealMM.add('(prefers-reduced-motion: reduce)', () => {
          gsap.set('.reveal', { opacity: 1, y: 0 });
          gsap.set('.reveal-rule', { scaleX: 1 });
        });
      }

      function loadGA() {
        if (!GA_ID || (window as any).__gaLoaded) return;
        (window as any).__gaLoaded = true;
        const s = document.createElement('script');
        s.async = true;
        s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(s);
        (window as any).dataLayer = (window as any).dataLayer || [];
        function gtag(...args: any[]) { (window as any).dataLayer.push(args); }
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true });
      }

      function initCookie() {
        const bar = document.querySelector('[data-cookie]') as HTMLElement | null;
        if (!bar) return;
        let consent: string | null = null;
        try { consent = localStorage.getItem('ac-cookie-consent'); } catch (e) {}
        if (consent === 'accepted') { loadGA(); bar.hidden = true; }
        else if (consent === 'declined') { bar.hidden = true; }
        else { bar.hidden = false; }
        if (bar.dataset.bound) return;
        bar.dataset.bound = 'true';
        const decide = (choice: string) => {
          try { localStorage.setItem('ac-cookie-consent', choice); } catch (e) {}
          bar.hidden = true;
          if (choice === 'accepted') loadGA();
        };
        bar.querySelector('[data-cookie-accept]')?.addEventListener('click', () => decide('accepted'));
        bar.querySelector('[data-cookie-decline]')?.addEventListener('click', () => decide('declined'));
      }

      function initAll() {
        initReveal();
        initCookie();
        ScrollTrigger.refresh();
      }
      // Bind immediately (covers the first load even if astro:page-load already fired)
      // and again after every View Transition swap.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll, { once: true });
      } else {
        initAll();
      }
      document.addEventListener('astro:page-load', initAll);
      // Tear down scroll triggers before a View Transition swaps the DOM.
      document.addEventListener('astro:before-swap', () => {
        revealMM?.revert();
        ScrollTrigger.getAll().forEach((t) => t.kill());
      });
    </script>
  </body>
</html>
