<script>
  let homeAbort: AbortController | undefined;

  function initHome() {
    homeAbort?.abort();
    homeAbort = new AbortController();
    const signal = homeAbort.signal;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reduce) {
      const items = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
      let ticking = false;
      const update = () => {
        const vh = window.innerHeight;
        for (const el of items) {
          const rect = el.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > vh) continue;
          const speed = parseFloat(el.dataset.speed || '0.15');
          const offset = (rect.top + rect.height / 2 - vh / 2) * -speed;
          el.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
        }
        ticking = false;
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      update();
      window.addEventListener('scroll', onScroll, { passive: true, signal });
      window.addEventListener('resize', update, { signal });
    }

    const stage = document.querySelector('[data-reviews]');
    if (stage) {
      const slides = Array.from(stage.querySelectorAll<HTMLElement>('[data-slide]'));
      const dots = Array.from(stage.querySelectorAll<HTMLElement>('[data-dot]'));
      const prev = stage.querySelector('[data-prev]');
      const next = stage.querySelector('[data-next]');
      let current = 0;
      let timer: ReturnType<typeof setInterval> | undefined;

      const go = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === current;
          slide.classList.toggle('active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        dots.forEach((dot, i) => {
          const active = i === current;
          dot.classList.toggle('active', active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      };

      const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
      const start = () => { if (reduce || slides.length < 2) return; stop(); timer = setInterval(() => go(current + 1), 6500); };
      signal.addEventListener('abort', stop);

      prev?.addEventListener('click', () => { go(current - 1); start(); }, { signal });
      next?.addEventListener('click', () => { go(current + 1); start(); }, { signal });
      dots.forEach((dot, i) => dot.addEventListener('click', () => { go(i); start(); }, { signal }));

      stage.addEventListener('mouseenter', stop, { signal });
      stage.addEventListener('mouseleave', start, { signal });
      stage.addEventListener('focusin', stop, { signal });
      stage.addEventListener('focusout', start, { signal });
      document.addEventListener('visibilitychange', () => { document.hidden ? stop() : start(); }, { signal });

      go(0);
      start();
    }
  }

  document.addEventListener('astro:page-load', initHome);
</script>
