---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import home from '../content/home.json';
import reviews from '../content/reviews.json';
import site from '../content/site.json';

import heroBg from '../assets/hero-wedding.jpg';
import angelaWarm from '../assets/angela-warm.jpg';
import angelaCandid from '../assets/angela-candid.jpg';
import angelaWerk from '../assets/angela-werk.png';
import statementImg from '../assets/hero-ceremony.jpg';
import handsImg from '../assets/hands-rings.jpg';
import aisleImg from '../assets/aisle-candles.jpg';
import candlesRosesImg from '../assets/candles-roses.jpg';
import ringExchangeImg from '../assets/ring-exchange.jpg';

const featured = reviews.filter((r) => r.uitgelicht);

const gallery: Record<string, ImageMetadata> = {
  'hands-rings': handsImg,
  'aisle-candles': aisleImg,
  'candles-roses': candlesRosesImg,
  'ring-exchange': ringExchangeImg,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.naam,
  description:
    'Persoonlijke trouwceremonies door Angela Bhagole-Mangre. Trouwambtenaar (BABS) en ceremoniespreker in Rotterdam, werkzaam door heel Nederland.',
  url: 'https://angelaceremonies.com',
  telephone: site.telefoonLink,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Rotterdam', addressCountry: 'NL' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  priceRange: '€€',
  serviceType: ['Trouwambtenaar', 'Ceremoniespreker', 'BABS', 'Coaching'],
  founder: { '@type': 'Person', name: site.persoon },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '5', reviewCount: String(reviews.length), bestRating: '5' },
};
---

<Base
  title="Trouwambtenaar Rotterdam | Angela Ceremonies"
  description="Persoonlijke trouwceremonies door Angela Bhagole-Mangre. BABS & ceremoniespreker in Rotterdam, werkzaam in heel Nederland."
  canonical="/"
  ogImage="/og/home.jpg"
  jsonLd={jsonLd}
  darkHero
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" data-parallax data-speed="0.12">
      <Image src={heroBg} alt={home.hero.achtergrondAlt} widths={[768, 1280, 1920, 2200]} sizes="100vw" fetchpriority="high" loading="eager" quality={70} format="webp" />
    </div>
    <div class="hero-scrim"></div>

    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="kicker hero-kicker he" style="--d:120ms">{home.hero.kicker}</p>
        <h1 class="hero-title">
          <span class="he" style="--d:260ms">{home.hero.titel}</span>
          <span class="he" style="--d:400ms"><em>{home.hero.titelAccent}</em></span>
        </h1>
        <p class="hero-sub he" style="--d:560ms">{home.hero.subtitel}</p>
        <div class="hero-trust he" style="--d:680ms">
          {home.hero.trust.map((t, i) => (
            <>
              {i > 0 && <span class="dot" aria-hidden="true">·</span>}
              <span>{t}</span>
            </>
          ))}
        </div>
        <div class="hero-actions he" style="--d:780ms">
          <a href={home.hero.knopPrimair.href} class="btn btn-gold">{home.hero.knopPrimair.label} <span class="arrow">→</span></a>
          <a href={home.hero.knopSecundair.href} class="hero-link">{home.hero.knopSecundair.label} <span class="arrow">→</span></a>
        </div>
      </div>

      <div class="hero-portrait he-media" style="--d:480ms">
        <div class="hero-portrait-frame">
          <Image src={angelaWarm} alt={home.hero.afbeeldingAlt} widths={[420, 640, 860]} sizes="(max-width: 900px) 70vw, 420px" quality={82} format="webp" loading="eager" />
        </div>
        <span class="hero-portrait-deco" aria-hidden="true"></span>
      </div>
    </div>

    <a href="#intro" class="hero-scroll" aria-label="Scroll naar beneden"><span>Scroll</span><span class="hero-scroll-line"></span></a>
  </section>

  <!-- INTRO (persoonlijk) -->
  <section class="section bg-cream" id="intro">
    <div class="wrap wrap-narrow intro">
      <p class="kicker reveal">{home.intro.kicker}</p>
      <h2 class="intro-title reveal" style="--reveal-delay:80ms">{home.intro.titel} <em>{home.intro.titelAccent}</em></h2>
      <div class="ornament intro-orn reveal" style="--reveal-delay:160ms"><span>✦</span></div>
      {home.intro.alineas.map((p, i) => (
        <p class="intro-p reveal" style={`--reveal-delay:${200 + i * 90}ms`}>{p}</p>
      ))}
    </div>
  </section>

  <!-- DIENSTEN -->
  <section class="section bg-champagne">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">{home.diensten.kicker}</p>
        <h2 class="sec-title">{home.diensten.titel}</h2>
      </div>
      <div class="services">
        {home.diensten.items.map((item, i) => (
          <a href={item.href} class="service reveal" style={`--reveal-delay:${i * 120}ms`}>
            <span class="service-num">{item.nummer}</span>
            <h3 class="service-title">{item.titel}</h3>
            <p class="service-text">{item.tekst}</p>
            <span class="link-more">Meer lezen <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STATEMENT / FOTO-BREAK -->
  <section class="statement">
    <div class="statement-media" data-parallax data-speed="0.12">
      <Image src={statementImg} alt={home.statement.afbeeldingAlt} widths={[768, 1280, 1800]} sizes="100vw" quality={70} format="webp" />
    </div>
    <div class="statement-scrim"></div>
    <blockquote class="statement-content wrap reveal">
      <p class="statement-text">{home.statement.tekst}</p>
    </blockquote>
  </section>

  <!-- OVER ANGELA (persoonlijk verhaal) -->
  <section class="section bg-cream">
    <div class="wrap about">
      <div class="about-media reveal">
        <div class="about-frame">
          <Image src={angelaCandid} alt={home.over.afbeeldingAlt} widths={[480, 720, 960]} sizes="(max-width: 880px) 90vw, 460px" quality={80} format="webp" />
        </div>
        <span class="about-deco about-deco-tl" aria-hidden="true"></span>
        <span class="about-deco about-deco-br" aria-hidden="true"></span>
      </div>
      <div class="about-body">
        <p class="kicker reveal">{home.over.kicker}</p>
        <h2 class="about-title reveal" style="--reveal-delay:80ms">{home.over.titel} <em>{home.over.titelAccent}</em></h2>
        <span class="rule reveal-rule" style="--reveal-delay:160ms"></span>
        {home.over.alineas.map((p, i) => (
          <p class="about-p reveal" style={`--reveal-delay:${180 + i * 80}ms`}>{p}</p>
        ))}
        <a href={home.over.knop.href} class="btn btn-outline reveal" style="--reveal-delay:420ms">{home.over.knop.label} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- WERKWIJZE -->
  <section class="section bg-champagne" id="werkwijze">
    <div class="wrap about about-reverse werkwijze">
      <div class="about-body">
        <p class="kicker reveal">{home.werkwijze.kicker}</p>
        <h2 class="about-title reveal" style="--reveal-delay:80ms">{home.werkwijze.titel}</h2>
        <span class="rule reveal-rule" style="--reveal-delay:150ms"></span>
        <p class="about-p reveal" style="--reveal-delay:170ms">{home.werkwijze.intro}</p>
        <ol class="steps-list">
          {home.werkwijze.stappen.map((s, i) => (
            <li class="step-item reveal" style={`--reveal-delay:${220 + i * 90}ms`}>
              <span class="step-num">{s.nummer}</span>
              <div>
                <h3 class="step-title">{s.titel}</h3>
                <p class="step-text">{s.tekst}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="about-media reveal" style="--reveal-delay:140ms">
        <div class="about-frame">
          <Image src={angelaWerk} alt={home.werkwijze.afbeeldingAlt} widths={[480, 720, 960]} sizes="(max-width: 880px) 90vw, 440px" quality={78} format="webp" />
        </div>
        <span class="about-deco about-deco-bl" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- CIJFERS -->
  <section class="stats">
    <div class="wrap stats-grid">
      {home.cijfers.map((stat, i) => (
        <div class="stat reveal" style={`--reveal-delay:${i * 130}ms`}>
          <span class="stat-num">{stat.getal}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="reviews-showcase">
    <span class="rs-glow" aria-hidden="true"></span>
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker kicker-gold">{home.reviews.kicker}</p>
        <h2 class="sec-title rs-title">{home.reviews.titel}</h2>
        <p class="rs-intro">{home.reviews.intro}</p>
      </div>

      <div class="rs-stage reveal" data-reviews aria-roledescription="carousel" aria-label="Wat bruidsparen vertellen">
        <span class="rs-mark" aria-hidden="true">&ldquo;</span>
        <div class="rs-track">
          {featured.map((r, i) => (
            <figure class:list={['rs-slide', { active: i === 0 }]} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
              <blockquote class="rs-text">{r.quote}</blockquote>
              <figcaption class="rs-cite">
                <span class="rs-name">{r.naam}</span>
                <span class="rs-sep" aria-hidden="true">·</span>
                <span class="rs-date">{r.datum}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="rs-controls">
          <button class="rs-arrow" type="button" data-prev aria-label="Vorige review"><span aria-hidden="true">&larr;</span></button>
          <div class="rs-dots" role="tablist" aria-label="Kies een review">
            {featured.map((_, i) => (
              <button class:list={['rs-dot', { active: i === 0 }]} type="button" data-dot aria-label={`Review ${i + 1} van ${featured.length}`} aria-selected={i === 0 ? 'true' : 'false'} role="tab"></button>
            ))}
          </div>
          <button class="rs-arrow" type="button" data-next aria-label="Volgende review"><span aria-hidden="true">&rarr;</span></button>
        </div>
      </div>

      <div class="rs-foot reveal">
        <a href={home.reviews.knop.href} class="link-more link-more-light">{home.reviews.knop.label} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- MOMENTEN (galerij) -->
  <section class="section bg-cream">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">{home.momenten.kicker}</p>
        <h2 class="sec-title">{home.momenten.titel}</h2>
        <p class="sec-lead">{home.momenten.intro}</p>
      </div>
      <div class="gallery">
        {home.momenten.items.map((item, i) => (
          <div class="gallery-item reveal" style={`--reveal-delay:${(i % 3) * 90}ms`}>
            {item.placeholder ? (
              <PlaceholderImage label={item.label} vorm="staand" />
            ) : (
              <div class="gallery-frame">
                <Image src={gallery[item.bron]} alt={item.alt} widths={[400, 640, 800]} sizes="(max-width: 700px) 90vw, 360px" quality={74} format="webp" />
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COACHING (slim teaser) -->
  <section class="section bg-champagne coaching-band">
    <div class="wrap coaching-inner reveal">
      <div class="coaching-copy">
        <p class="kicker">{home.coaching.kicker}</p>
        <h2 class="coaching-title">{home.coaching.titel}</h2>
        <p class="coaching-text">{home.coaching.tekst}</p>
      </div>
      <a href={home.coaching.knop.href} class="btn btn-outline">{home.coaching.knop.label} <span class="arrow">→</span></a>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-cream cta">
    <div class="wrap wrap-narrow cta-inner reveal">
      <p class="kicker">{home.cta.kicker}</p>
      <h2 class="cta-title">{home.cta.titel}</h2>
      <div class="ornament cta-orn"><span>✦</span></div>
      <p class="cta-text">{home.cta.tekst}</p>
      <div class="cta-actions">
        <a href={home.cta.knop.href} class="btn btn-gold">{home.cta.knop.label} <span class="arrow">→</span></a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-outline" data-hb-goal="whatsapp">WhatsApp Angela</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bg-cream { background: var(--cream); }
  .bg-champagne { background: linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 9%, var(--cream-deep) 91%, var(--cream) 100%); }

  /* ===== HERO (cinematic split) ===== */
  .hero {
    position: relative;
    min-height: 94svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    padding-top: 96px;
    padding-bottom: clamp(2rem, 5vw, 4rem);
  }
  .hero-bg { position: absolute; inset: -8% 0; z-index: -2; }
  .hero-bg :global(img) { width: 100%; height: 116%; object-fit: cover; object-position: 50% 55%; }
  .hero-scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(100deg, hsl(26 36% 9% / 0.85) 0%, hsl(27 34% 12% / 0.55) 40%, hsl(26 32% 14% / 0.12) 100%),
      linear-gradient(0deg, var(--cream) -2%, transparent 14%),
      hsl(28 40% 16% / 0.16);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.8fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    width: 100%;
  }
  .hero-text { color: var(--cream); max-width: 36rem; }
  .hero-kicker { color: hsl(40 40% 92% / 0.85); margin-bottom: 1.4rem; }
  .hero-title { color: var(--cream); font-weight: 500; font-size: clamp(2.6rem, 1.9rem + 4.4vw, 5.25rem); line-height: 1.03; letter-spacing: -0.015em; }
  .hero-title span { display: block; }
  .hero-title em { font-style: italic; color: hsl(38 58% 80%); }
  .hero-sub { margin-top: 1.6rem; font-size: clamp(1.05rem, 1rem + 0.45vw, 1.3rem); font-weight: 300; line-height: 1.6; color: hsl(40 40% 94% / 0.94); max-width: 32ch; }
  .hero-trust { display: flex; align-items: center; flex-wrap: wrap; gap: 0.7rem; margin-top: 1.8rem; font-size: 0.74rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: hsl(40 40% 90% / 0.78); }
  .hero-trust .dot { color: var(--gold-soft); }
  .hero-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; margin-top: 2.2rem; }
  .hero-link { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--cream); text-decoration: none; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; padding-bottom: 2px; border-bottom: 1px solid hsl(40 40% 90% / 0.4); transition: border-color 0.3s ease; }
  .hero-link:hover { border-color: var(--gold-soft); }
  .hero-link .arrow { transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .hero-link:hover .arrow { transform: translateX(4px); }

  .hero-portrait { position: relative; justify-self: center; width: 100%; max-width: 420px; }
  .hero-portrait-frame { overflow: hidden; border-radius: 4px; aspect-ratio: 4 / 5; box-shadow: 0 30px 60px -28px hsl(26 40% 6% / 0.7); border: 1px solid hsl(40 40% 92% / 0.18); }
  .hero-portrait-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; }
  .hero-portrait-deco { position: absolute; width: 92px; height: 92px; border: 1px solid var(--gold-soft); opacity: 0.6; bottom: -16px; left: -16px; border-right: 0; border-top: 0; }

  .hero-scroll { position: absolute; bottom: 1.6rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 0.6rem; text-decoration: none; color: hsl(40 40% 94% / 0.55); font-size: 0.64rem; letter-spacing: 0.24em; text-transform: uppercase; }
  .hero-scroll-line { width: 1px; height: 40px; background: linear-gradient(hsl(40 40% 94% / 0.6), transparent); }

  /* Hero entrance */
  .he { opacity: 0; animation: he-up 1s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) forwards; }
  .he-media { opacity: 0; animation: he-up 1.2s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) forwards; }
  @keyframes he-up { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .he, .he-media { opacity: 1; animation: none; } }

  @media (max-width: 900px) {
    .hero { min-height: 0; padding-top: 110px; padding-bottom: 3.5rem; text-align: center; }
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-text { max-width: none; margin-inline: auto; }
    .hero-sub { margin-inline: auto; }
    .hero-trust, .hero-actions { justify-content: center; }
    .hero-portrait { order: -1; max-width: 280px; }
    .hero-scroll { display: none; }
  }

  /* ===== Shared section heads ===== */
  .sec-head { text-align: center; max-width: 640px; margin: 0 auto clamp(3rem, 5vw, 4.5rem); }
  .sec-head .kicker { margin-bottom: 0.9rem; }
  .sec-title { font-size: clamp(1.9rem, 1.4rem + 2vw, 3rem); }
  .sec-lead { color: var(--muted); margin-top: 1.1rem; font-size: 1.05rem; }

  /* ===== INTRO ===== */
  .intro { text-align: center; }
  .intro .kicker { margin-bottom: 1.1rem; }
  .intro-title { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem); margin-bottom: 0.5rem; }
  .intro-title em { font-style: italic; color: var(--gold); }
  .intro-orn { max-width: 90px; margin: 2rem auto; }
  .intro-p { color: var(--muted); margin-bottom: 1.4rem; font-size: 1.075rem; }
  .intro-p:last-child { margin-bottom: 0; }

  /* ===== DIENSTEN ===== */
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.5vw, 2rem); }
  .service { display: flex; flex-direction: column; align-items: flex-start; gap: 0.85rem; padding: clamp(1.75rem, 3vw, 2.6rem); background: var(--white); border: 1px solid var(--line); border-radius: 3px; text-decoration: none; color: inherit; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease, border-color 0.5s ease; }
  .service:hover { transform: translateY(-6px); box-shadow: var(--shadow-lift); border-color: hsl(36 40% 75%); }
  .service-num { font-family: var(--font-display); font-style: italic; font-size: 1.05rem; color: var(--gold); letter-spacing: 0.05em; }
  .service-title { font-size: 1.4rem; }
  .service-text { color: var(--muted); font-size: 0.98rem; flex: 1; }
  .service .link-more { margin-top: 0.5rem; }

  /* ===== STATEMENT / FOTO-BREAK ===== */
  .statement { position: relative; overflow: hidden; isolation: isolate; padding-block: clamp(6rem, 14vw, 11rem); display: flex; align-items: center; justify-content: center; }
  .statement-media { position: absolute; inset: -12% 0; z-index: -2; }
  .statement-media :global(img) { width: 100%; height: 124%; object-fit: cover; object-position: center 40%; }
  .statement-scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, var(--cream) -2%, transparent 12%, transparent 88%, var(--cream) 102%), hsl(26 30% 12% / 0.58); }
  .statement-content { text-align: center; max-width: 920px; margin: 0; }
  .statement-text { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: clamp(1.6rem, 1.1rem + 2.4vw, 3rem); line-height: 1.34; color: var(--white); }

  /* ===== ABOUT (gedeeld) ===== */
  .about { display: grid; grid-template-columns: 0.82fr 1fr; gap: clamp(2.5rem, 6vw, 5.5rem); align-items: center; }
  .about-reverse { grid-template-columns: 1fr 0.82fr; }
  .about-media { position: relative; }
  .about-frame { position: relative; overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 5; }
  .about-frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .about-media:hover .about-frame :global(img) { transform: scale(1.04); }
  .about-deco { position: absolute; width: 92px; height: 92px; border: 1px solid var(--gold); opacity: 0.5; }
  .about-deco-tl { top: -16px; left: -16px; border-right: 0; border-bottom: 0; }
  .about-deco-br { bottom: -16px; right: -16px; border-left: 0; border-top: 0; }
  .about-deco-bl { bottom: -16px; left: -16px; border-right: 0; border-top: 0; }
  .about-title { font-size: clamp(1.9rem, 1.4rem + 2.2vw, 3.1rem); margin-bottom: 1.4rem; line-height: 1.08; }
  .about-title em { font-style: italic; color: var(--gold); }
  .about-body .rule { margin-bottom: 1.8rem; }
  .about-p { color: var(--muted); margin-bottom: 1.2rem; }
  .about-body .btn { margin-top: 1rem; }
  .about-body .kicker { margin-bottom: 1rem; }

  /* ===== WERKWIJZE ===== */
  .steps-list { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .step-item { display: flex; gap: 1.1rem; align-items: flex-start; }
  .step-num { font-family: var(--font-display); font-size: 1.4rem; color: var(--gold); line-height: 1; flex: none; padding-top: 0.15rem; min-width: 2ch; }
  .step-title { font-size: 1.2rem; margin-bottom: 0.35rem; }
  .step-text { color: var(--muted); font-size: 0.97rem; }

  /* ===== STATS ===== */
  .stats { position: relative; background: linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 50%, var(--cream) 100%); color: var(--brown); padding-block: clamp(3.25rem, 6vw, 5rem); }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; text-align: center; }
