    transition: border-color 0.4s ease, background 0.4s ease, transform 0.4s ease;
  }
  .rs-arrow:hover { border-color: var(--gold-soft); background: hsl(38 50% 60% / 0.12); transform: translateY(-2px); }
  .rs-arrow:focus-visible { outline: 2px solid var(--gold-soft); outline-offset: 3px; }
  .rs-dots { display: flex; align-items: center; gap: 0.35rem; }
