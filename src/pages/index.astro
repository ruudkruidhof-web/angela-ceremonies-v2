  @media (max-width: 700px) {
    .hero-scroll { display: none; }
  }
  @media (max-width: 560px) {
    .gallery-bleed { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  let homeMM: ReturnType<typeof gsap.matchMedia> | undefined;

  function initHome() {
    homeMM?.revert();
    homeMM = gsap.matchMedia();

    homeMM.add('(prefers-reduced-motion: no-preference)', () => {
      const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
      intro.from('.hero .he', { opacity: 0, y: 28, duration: 1, stagger: 0.14, delay: 0.15 });

      const parallax = gsap.to('.hero-media', {
        yPercent: 16,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true },
      });

      return () => {
        intro.kill();
        parallax.scrollTrigger?.kill();
        parallax.kill();
        gsap.set('.hero .he', { clearProps: 'all' });
      };
    });

    homeMM.add('(prefers-reduced-motion: reduce)', () => {
      gsap.set('.hero .he', { opacity: 1, y: 0 });
    });
  }

  document.addEventListener('astro:page-load', initHome);
</script>
