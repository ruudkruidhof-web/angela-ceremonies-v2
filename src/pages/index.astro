  .cta-text { color: var(--muted); font-size: 1.075rem; margin-bottom: 2.2rem; line-height: 1.8; }
  .cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 900px) {
    .overlap { grid-template-columns: 1fr; }
    .overlap-media { grid-column: 1; grid-row: 1; aspect-ratio: 3 / 2; }
    .overlap-panel { grid-column: 1; grid-row: 2; margin-left: 0; margin-top: -2.5rem; margin-inline: 1rem 0; }
    .review-row { grid-template-columns: 1fr; gap: 2rem; }
    .rr-media { aspect-ratio: 3 / 2; }
    .rr-body { max-width: none; }
    .feature, .feature-reverse { grid-template-columns: 1fr; gap: 2.5rem; }
    .feature-reverse .feature-body { order: 2; }
    .feature-media { max-width: 460px; margin-inline: auto; }
    .cf-grid { grid-template-columns: 1fr; gap: 2.5rem; }
