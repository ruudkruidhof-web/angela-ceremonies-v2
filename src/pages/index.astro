---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import home from '../content/home.json';
import reviews from '../content/reviews.json';
import site from '../content/site.json';

import heroImg from '../assets/couple-joy.jpg';
import coupleHero from '../assets/couple-hero.jpg';
import coupleElegant from '../assets/couple-elegant.jpg';
import coupleBeach from '../assets/couple-beach.jpg';
import angelaCandid from '../assets/angela-candid.jpg';
import angelaWerk from '../assets/angela-werk.png';
import angelaToga from '../assets/angela-toga.jpg';
import visionImg from '../assets/ring-exchange.jpg';
import handsImg from '../assets/hands-rings.jpg';
import aisleImg from '../assets/aisle-candles.jpg';
import candlesRoses from '../assets/candles-roses.jpg';

const reviewMedia: Record<string, ImageMetadata> = {
  'couple-hero': coupleHero,
  'couple-elegant': coupleElegant,
};
const gallery: Record<string, ImageMetadata> = {
  'couple-beach': coupleBeach,
  'hands-rings': handsImg,
  'aisle-candles': aisleImg,
  'candles-roses': candlesRoses,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.naam,
  description:
    'Persoonlijke trouwceremonies door Angela Bhagole-Mangre. Trouwambtenaar (BABS) en ceremoniespreker in Rotterdam, werkzaam door heel Nederland.',
  url: 'https://angelaceremonies.com',
  telephone: site.telefoonLink,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Rotterdam', addressCountry: 'NL' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  priceRange: '€€',
  founder: { '@type': 'Person', name: site.persoon },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '5', reviewCount: String(reviews.length), bestRating: '5' },
};

const blockA = home.reviewBlocks[0];
const blockB = home.reviewBlocks[1];
---

<Base
  title="Trouwambtenaar Rotterdam | Angela Ceremonies"
  description="Persoonlijke trouwceremonies door Angela Bhagole-Mangre. BABS & ceremoniespreker in Rotterdam, werkzaam in heel Nederland."
  canonical="/"
  ogImage="/og/home.jpg"
  jsonLd={jsonLd}
  darkHero
>
  <section class="hero">
    <div class="hero-media">
      <Image src={heroImg} alt={home.hero.afbeeldingAlt} widths={[768, 1280, 1920]} sizes="100vw" fetchpriority="high" loading="eager" quality={72} format="webp" />
    </div>
    <div class="hero-scrim"></div>
    <div class="wrap hero-inner">
      <a href={home.hero.ratingHref} class="hero-rating he"><span class="stars" aria-hidden="true">★★★★★</span> {home.hero.rating}</a>
      <h1 class="hero-title">
        <span class="he">{home.hero.titel}</span>
        <span class="he"><em>{home.hero.titelAccent}</em></span>
      </h1>
      <p class="hero-sub he">{home.hero.subtitel}</p>
      <div class="hero-actions he">
        <a href={home.hero.knop.href} class="btn btn-gold">{home.hero.knop.label} <span class="arrow">→</span></a>
      </div>
    </div>
    <a href="#statement" class="hero-scroll" aria-label="Scroll naar beneden"><span>Scroll</span><span class="hero-scroll-line"></span></a>
  </section>

  <section class="section bg-cream statement" id="statement">
    <div class="wrap statement-inner reveal">
      <p class="statement-text rich" set:html={home.statement.html}></p>
      <a href={home.statement.knop.href} class="btn btn-gold statement-btn">{home.statement.knop.label} <span class="arrow">→</span></a>
    </div>
  </section>

  <section class="section bg-champagne">
    <div class="wrap feature">
      <div class="feature-media reveal">
        <div class="feature-frame">
          <Image src={angelaCandid} alt={home.intro.afbeeldingAlt} widths={[480, 760, 1000]} sizes="(max-width: 900px) 90vw, 480px" quality={80} format="webp" />
        </div>
        <span class="feature-deco" aria-hidden="true"></span>
      </div>
      <div class="feature-body reveal">
        <p class="kicker">{home.intro.kicker}</p>
        <h2 class="feature-title">{home.intro.titel} <em>{home.intro.titelAccent}</em></h2>
        <div class="prose rich">
          {home.intro.html.map((p) => <p set:html={p}></p>)}
        </div>
        <p class="signature script">{home.intro.signatuur}</p>
        <a href={home.intro.knop.href} class="btn btn-outline">{home.intro.knop.label} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="wrap overlap reveal">
      <div class="overlap-media">
        <Image src={visionImg} alt={home.vision.afbeeldingAlt} widths={[600, 1000, 1300]} sizes="(max-width: 900px) 92vw, 680px" quality={78} format="webp" />
      </div>
      <div class="overlap-panel">
        <p class="kicker kicker-gold">{home.vision.kicker}</p>
        <h2 class="overlap-title">{home.vision.titel}</h2>
        <p class="overlap-text rich" set:html={home.vision.html}></p>
      </div>
    </div>
  </section>

  <section class="section bg-champagne">
    <figure class="wrap review-row reveal">
      <div class="rr-media">
        <Image src={reviewMedia[blockA.bron]} alt={blockA.fotoAlt} widths={[480, 800, 1100]} sizes="(max-width: 900px) 90vw, 540px" quality={78} format="webp" />
      </div>
      <figcaption class="rr-body">
        <span class="rr-stars" aria-hidden="true">★★★★★</span>
        <blockquote class="rr-quote rich" set:html={blockA.quoteHtml}></blockquote>
        <p class="rr-cite">{blockA.naam} <span class="rr-date">· {blockA.datum}</span></p>
      </figcaption>
    </figure>
  </section>

  <section class="section bg-cream">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">{home.diensten.kicker}</p>
        <h2 class="sec-title">{home.diensten.titel}</h2>
      </div>
      <div class="services">
        {home.diensten.items.map((item, i) => (
          <a href={item.href} class="service reveal" style={`--reveal-delay:${i * 120}ms`}>
            <span class="service-num">{item.nummer}</span>
            <h3 class="service-title">{item.titel}</h3>
            <p class="service-text">{item.tekst}</p>
            <span class="link-more">Meer lezen <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-champagne">
    <div class="wrap feature feature-reverse">
      <div class="feature-body reveal">
        <p class="kicker">{home.craft.kicker}</p>
        <h2 class="feature-title">{home.craft.titel}</h2>
        <p class="prose rich" set:html={home.craft.html}></p>
        <a href={home.craft.knop.href} class="btn btn-gold">{home.craft.knop.label} <span class="arrow">→</span></a>
      </div>
      <div class="feature-media reveal">
        <div class="feature-frame">
          <Image src={angelaWerk} alt={home.craft.afbeeldingAlt} widths={[480, 760, 1000]} sizes="(max-width: 900px) 90vw, 460px" quality={78} format="webp" />
        </div>
        <span class="feature-deco feature-deco-left" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <figure class="wrap review-row review-row-rev reveal">
      <div class="rr-media">
        <Image src={reviewMedia[blockB.bron]} alt={blockB.fotoAlt} widths={[480, 800, 1100]} sizes="(max-width: 900px) 90vw, 540px" quality={78} format="webp" />
      </div>
      <figcaption class="rr-body">
        <span class="rr-stars" aria-hidden="true">★★★★★</span>
        <blockquote class="rr-quote rich" set:html={blockB.quoteHtml}></blockquote>
        <p class="rr-cite">{blockB.naam} <span class="rr-date">· {blockB.datum}</span></p>
        <a href={home.reviewsLink.href} class="link-more rr-link">{home.reviewsLink.label} <span class="arrow">→</span></a>
      </figcaption>
    </figure>
  </section>

  <section class="coaching-feature">
    <div class="wrap cf-grid">
      <div class="cf-media reveal">
        <Image src={angelaToga} alt={home.coaching.afbeeldingAlt} widths={[480, 760, 1000]} sizes="(max-width: 900px) 90vw, 480px" quality={78} format="webp" />
      </div>
      <div class="cf-body reveal">
        <p class="kicker kicker-gold">{home.coaching.kicker}</p>
        <h2 class="cf-title">{home.coaching.titel}</h2>
        <p class="cf-text rich" set:html={home.coaching.html}></p>
        <a href={home.coaching.knop.href} class="btn btn-gold">{home.coaching.knop.label} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="momenten">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">{home.momenten.kicker}</p>
        <h2 class="sec-title">{home.momenten.titel}</h2>
      </div>
    </div>
    <div class="gallery-bleed reveal">
      {home.momenten.items.map((item) => (
        <div class="gb-item">
          {item.placeholder ? (
            <PlaceholderImage label={item.label} vorm="vierkant" />
          ) : (
            <div class="gb-frame"><Image src={gallery[item.bron]} alt={item.alt} widths={[400, 640, 760]} sizes="(max-width: 700px) 50vw, 33vw" quality={74} format="webp" /></div>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="video-section">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker kicker-gold">{home.video.kicker}</p>
        <h2 class="sec-title video-title">{home.video.titel}</h2>
        <p class="video-intro">{home.video.intro}</p>
      </div>
      <div class="video-frame reveal">
        <span class="video-play" aria-hidden="true">▶</span>
        <span class="video-label">{home.video.placeholderLabel}</span>
        <span class="video-soon">Video volgt</span>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="wrap stats-grid">
      {home.cijfers.map((stat, i) => (
        <div class="stat reveal" style={`--reveal-delay:${i * 130}ms`}>
          <span class="stat-num">{stat.getal}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section bg-cream cta">
    <div class="wrap wrap-narrow cta-inner reveal">
      <p class="kicker">{home.cta.kicker}</p>
      <h2 class="cta-title rich" set:html={home.cta.titelHtml}></h2>
      <div class="ornament cta-orn"><span>✦</span></div>
      <p class="cta-text">{home.cta.tekst}</p>
      <div class="cta-actions">
        <a href={home.cta.knop.href} class="btn btn-gold">{home.cta.knop.label} <span class="arrow">→</span></a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-outline" data-hb-goal="whatsapp">WhatsApp Angela</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bg-cream { background: var(--cream); }
  .bg-champagne { background: linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 9%, var(--cream-deep) 91%, var(--cream) 100%); }

  /* ===== HERO ===== */
  .hero { position: relative; min-height: 78svh; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; padding-bottom: clamp(3rem, 6vw, 5.5rem); }
  .hero-media { position: absolute; inset: -10% 0 0; z-index: -2; }
  .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 32%; }
  .hero-scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, hsl(26 32% 8% / 0.62) 0%, hsl(26 30% 10% / 0.28) 22%, hsl(26 30% 10% / 0.34) 52%, hsl(26 32% 7% / 0.82) 100%), linear-gradient(0deg, var(--cream) -1%, transparent 16%); }
  .hero-inner { color: var(--cream); max-width: 940px; text-align: center; margin-inline: auto; }
  .hero-rating { display: inline-flex; align-items: center; gap: 0.55rem; color: hsl(40 40% 94% / 0.92); text-decoration: none; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.6rem; }
  .hero-rating .stars { color: var(--gold-soft); letter-spacing: 0.1em; font-size: 0.92rem; }
  .hero-rating:hover { color: var(--cream); }
  .hero-title { color: var(--cream); font-weight: 400; font-size: clamp(2.7rem, 2rem + 4.6vw, 5.6rem); line-height: 1.02; letter-spacing: -0.02em; }
  .hero-title span { display: block; }
  .hero-title em { font-style: italic; color: hsl(38 58% 82%); }
  .hero-sub { margin: 1.5rem auto 0; font-size: clamp(1.05rem, 1rem + 0.5vw, 1.32rem); font-weight: 300; line-height: 1.6; color: hsl(40 40% 95% / 0.94); max-width: 40ch; }
  .hero-actions { margin-top: 2.1rem; }
  .hero-scroll { position: absolute; bottom: 1.4rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 0.55rem; text-decoration: none; color: hsl(40 40% 94% / 0.55); font-size: 0.62rem; letter-spacing: 0.24em; text-transform: uppercase; }
  .hero-scroll-line { width: 1px; height: 38px; background: linear-gradient(hsl(40 40% 94% / 0.6), transparent); }
  .js .he { opacity: 0; }

  /* ===== shared heads ===== */
  .sec-head { text-align: center; max-width: 660px; margin: 0 auto clamp(3rem, 5vw, 4.5rem); }
  .sec-head .kicker { margin-bottom: 0.9rem; }
  .sec-title { font-size: clamp(1.9rem, 1.4rem + 2vw, 3rem); font-weight: 400; }
  .kicker-gold { color: var(--gold-soft); }

  /* ===== STATEMENT ===== */
  .statement-inner { text-align: center; max-width: 1040px; margin-inline: auto; }
  .statement-text { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.5rem, 1.1rem + 2vw, 2.7rem); line-height: 1.34; color: var(--ink); }
  .statement-text :global(em) { color: var(--gold); font-style: italic; }
  .statement-text :global(strong) { color: var(--ink); font-weight: 700; }
  .statement-btn { margin-top: 2.2rem; }

  /* ===== FEATURE SPLIT ===== */
  .feature { display: grid; grid-template-columns: 0.92fr 1fr; gap: clamp(2.5rem, 6vw, 5.5rem); align-items: center; }
  .feature-reverse { grid-template-columns: 1fr 0.92fr; }
  .feature-media { position: relative; }
  .feature-frame { overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 5; }
  .feature-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .feature-media:hover .feature-frame :global(img) { transform: scale(1.04); }
  .feature-deco { position: absolute; width: 90px; height: 90px; border: 1px solid var(--gold); opacity: 0.5; bottom: -16px; right: -16px; border-left: 0; border-top: 0; }
  .feature-deco-left { right: auto; left: -16px; border-left: 1px solid var(--gold); border-right: 0; border-top: 0; }
  .feature-body .kicker { margin-bottom: 1rem; }
  .feature-title { font-size: clamp(2rem, 1.5rem + 2.2vw, 3.2rem); font-weight: 400; line-height: 1.08; margin-bottom: 1.5rem; }
  .feature-title em { font-style: italic; color: var(--gold); }
  .prose { color: var(--muted); line-height: 1.85; margin-bottom: 1.8rem; }
  .prose p { margin-bottom: 1.2rem; }
  .prose :global(em) { color: var(--gold); font-style: italic; }
  .prose :global(strong) { color: var(--ink); font-weight: 700; }
  .signature { font-size: 2.6rem; color: var(--gold); line-height: 1; margin: 0.4rem 0 1.6rem; }

  /* ===== VISION OVERLAP (grote foto + gekleurd blok) ===== */
  .overlap { display: grid; grid-template-columns: 1.12fr 0.88fr; align-items: center; }
  .overlap-media { grid-column: 1; grid-row: 1; z-index: 1; overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 3; }
  .overlap-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .overlap-media :global(.ph-img) { height: 100%; }
  .overlap-panel { grid-column: 2; grid-row: 1; z-index: 2; margin-left: -22%; background: var(--ink); color: var(--cream); padding: clamp(2.25rem, 4.5vw, 4rem); border-radius: 3px; box-shadow: var(--shadow-lift); border: 1px solid hsl(36 30% 50% / 0.22); }
  .overlap-panel .kicker-gold { margin-bottom: 1rem; }
  .overlap-title { color: var(--cream); font-weight: 400; font-size: clamp(1.8rem, 1.3rem + 1.9vw, 2.8rem); line-height: 1.12; margin-bottom: 1.4rem; }
  .overlap-text { color: hsl(40 26% 84% / 0.92); line-height: 1.85; font-size: clamp(1rem, 0.97rem + 0.3vw, 1.12rem); }
  .overlap-text :global(em) { color: var(--gold-soft); font-style: italic; }
  .overlap-text :global(strong) { color: var(--cream); font-weight: 700; }

  /* ===== REVIEW ROW (grote foto + grote italic-quote, afwisselend) ===== */
  .review-row { display: grid; grid-template-columns: 1.02fr 0.98fr; gap: clamp(2.25rem, 5vw, 4.5rem); align-items: center; margin: 0; }
  .rr-media { overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 5; }
  .rr-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .review-row:hover .rr-media :global(img) { transform: scale(1.04); }
  .rr-body { max-width: 38ch; }
  .rr-stars { color: var(--gold-soft); font-size: 1.05rem; letter-spacing: 0.18em; }
  .rr-quote { margin: 1.1rem 0 1.6rem; font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: clamp(1.5rem, 1.15rem + 1.6vw, 2.4rem); line-height: 1.38; color: var(--ink); }
  .rr-quote :global(em) { color: var(--gold); }
  .rr-quote :global(strong) { color: var(--ink); font-weight: 600; font-style: normal; }
  .rr-cite { font-family: var(--font-display); font-size: 1.2rem; color: var(--gold); }
  .rr-date { color: var(--muted); font-size: 0.82rem; font-family: var(--font-body); }
  .rr-link { margin-top: 1.6rem; }
  @media (min-width: 901px) {
    .review-row-rev .rr-media { order: 2; }
    .review-row-rev .rr-body { order: 1; justify-self: end; }
  }

  /* ===== DIENSTEN ===== */
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.5vw, 2rem); }
  .service { display: flex; flex-direction: column; align-items: flex-start; gap: 0.85rem; padding: clamp(1.75rem, 3vw, 2.6rem); background: var(--white); border: 1px solid var(--line); border-radius: 3px; text-decoration: none; color: inherit; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease, border-color 0.5s ease; }
  .service:hover { transform: translateY(-6px); box-shadow: var(--shadow-lift); border-color: hsl(36 40% 75%); }
  .service-num { font-family: var(--font-display); font-style: italic; font-size: 1.05rem; color: var(--gold); }
  .service-title { font-size: 1.4rem; font-weight: 400; }
  .service-text { color: var(--muted); font-size: 0.98rem; flex: 1; line-height: 1.7; }

  /* ===== COACHING (donkere split, tweede aanbod) ===== */
  .coaching-feature { background: radial-gradient(120% 130% at 100% 0%, hsl(28 28% 22%), hsl(26 30% 13%)); color: var(--cream); padding-block: clamp(4.5rem, 9vw, 7.5rem); }
  .cf-grid { display: grid; grid-template-columns: 0.9fr 1fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .cf-media { overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 5; }
  .cf-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .cf-grid:hover .cf-media :global(img) { transform: scale(1.04); }
  .cf-title { color: var(--cream); font-weight: 400; font-size: clamp(1.8rem, 1.4rem + 1.8vw, 2.8rem); line-height: 1.1; margin: 0.9rem 0 1.3rem; }
  .cf-text { color: hsl(40 26% 84% / 0.9); line-height: 1.85; font-size: 1.05rem; margin-bottom: 1.9rem; }
  .cf-text :global(em) { color: var(--gold-soft); font-style: italic; }
  .cf-text :global(strong) { color: var(--cream); font-weight: 700; }

  /* ===== VIDEO ===== */
  .video-section { background: radial-gradient(130% 120% at 50% 0%, hsl(28 28% 22%), hsl(26 30% 13%)); color: var(--cream); padding-block: clamp(4.5rem, 9vw, 7.5rem); }
  .video-title { color: var(--cream); }
  .video-intro { color: hsl(40 26% 80% / 0.85); margin-top: 1rem; font-style: italic; font-family: var(--font-display); font-size: 1.15rem; }
  .video-frame { position: relative; max-width: 900px; margin-inline: auto; aspect-ratio: 16 / 9; border-radius: 4px; border: 1px solid hsl(40 30% 80% / 0.2); background: repeating-linear-gradient(135deg, hsl(26 28% 16%) 0 14px, hsl(26 28% 18%) 14px 28px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.9rem; }
  .video-play { width: 68px; height: 68px; border-radius: 50%; display: grid; place-items: center; background: var(--gold); color: hsl(26 30% 14%); font-size: 1.3rem; padding-left: 4px; }
  .video-label { font-family: var(--font-display); font-style: italic; font-size: 1.1rem; color: hsl(40 30% 86%); }
  .video-soon { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-soft); }

  /* ===== MOMENTEN (edge-to-edge) ===== */
  .momenten { padding-block: clamp(4.5rem, 9vw, 7rem) 0; background: var(--cream); }
  .gallery-bleed { display: grid; grid-template-columns: repeat(6, 1fr); margin-top: clamp(2rem, 4vw, 3rem); }
  .gb-item { aspect-ratio: 1 / 1; overflow: hidden; }
  .gb-frame { width: 100%; height: 100%; overflow: hidden; }
  .gb-frame :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1); }
  .gb-item:hover .gb-frame :global(img) { transform: scale(1.06); }
  .gb-item :global(.ph-img) { height: 100%; border-radius: 0; border: 0; border-right: 1px solid hsl(40 40% 99% / 0.5); }

  /* ===== STATS ===== */
  .stats { position: relative; background: var(--cream-deep); color: var(--brown); padding-block: clamp(3.25rem, 6vw, 5rem); }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; text-align: center; }
  .stat { display: flex; flex-direction: column; gap: 0.7rem; position: relative; }
  .stat:not(:last-child)::after { content: ''; position: absolute; right: -1rem; top: 18%; height: 64%; width: 1px; background: var(--line); }
  .stat-num { font-family: var(--font-display); font-size: clamp(2.4rem, 1.8rem + 2.5vw, 3.6rem); color: var(--gold); line-height: 1; }
  .stat-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

  /* ===== CTA ===== */
  .cta-inner { text-align: center; }
