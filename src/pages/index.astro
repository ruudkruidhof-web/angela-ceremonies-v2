---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import home from '../content/home.json';
import reviews from '../content/reviews.json';
import site from '../content/site.json';

import heroImg from '../assets/hero-wedding.jpg';
import handsImg from '../assets/hands-rings.jpg';
import angelaImg from '../assets/angela-toga.jpg';
import coachingImg from '../assets/aisle-candles.jpg';

const featured = reviews.filter((r) => r.uitgelicht);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.naam,
  description:
    'Persoonlijke trouwceremonies door Angela Bhagole-Mangre. Trouwambtenaar (BABS) en ceremoniespreker in Rotterdam, werkzaam door heel Nederland.',
  url: 'https://angelaceremonies.com',
  telephone: site.telefoonLink,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Rotterdam', addressCountry: 'NL' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  priceRange: '€€',
  serviceType: ['Trouwambtenaar', 'Ceremoniespreker', 'BABS', 'Coaching'],
  founder: { '@type': 'Person', name: site.persoon },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    reviewCount: String(reviews.length),
    bestRating: '5',
  },
};
---

<Base
  title="Trouwambtenaar Rotterdam | Angela Ceremonies"
  description="Persoonlijke trouwceremonies door Angela Bhagole-Mangre. BABS & ceremoniespreker in Rotterdam, werkzaam in heel Nederland."
  canonical="/"
  ogImage="/og/home.jpg"
  jsonLd={jsonLd}
  darkHero
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-media" data-parallax data-speed="0.16">
      <Image
        src={heroImg}
        alt={home.hero.afbeeldingAlt}
        widths={[768, 1280, 1920, 2200]}
        sizes="100vw"
        fetchpriority="high"
        loading="eager"
        quality={72}
        format="webp"
        class="hero-img"
      />
    </div>
    <div class="hero-scrim"></div>

    <div class="hero-content wrap">
      <p class="kicker hero-kicker">{home.hero.kicker}</p>
      <h1 class="hero-title">
        <span class="hero-line-1">{home.hero.titel}</span>
        <span class="hero-line-2"><em>{home.hero.titelAccent}</em></span>
      </h1>
      <span class="hero-rule"></span>
      <p class="hero-sub">{home.hero.subtitel}</p>
      <div class="hero-actions">
        <a href={home.hero.knopPrimair.href} class="btn btn-ghost">{home.hero.knopPrimair.label}</a>
        <a href={home.hero.knopSecundair.href} class="btn btn-gold">{home.hero.knopSecundair.label} <span class="arrow">→</span></a>
      </div>
    </div>

    <a href="#intro" class="hero-scroll" aria-label="Scroll naar beneden">
      <span>Scroll</span>
      <span class="hero-scroll-line"></span>
    </a>
  </section>

  <!-- INTRO -->
  <section class="section bg-cream" id="intro">
    <div class="wrap wrap-narrow intro">
      <p class="kicker reveal">{home.intro.kicker}</p>
      <h2 class="intro-title reveal" style="--reveal-delay:80ms">{home.intro.titel}</h2>
      <div class="ornament intro-orn reveal" style="--reveal-delay:160ms"><span>✦</span></div>
      {home.intro.alineas.map((p, i) => (
        <p class="intro-p reveal" style={`--reveal-delay:${200 + i * 90}ms`}>{p}</p>
      ))}
    </div>
  </section>

  <!-- DIENSTEN -->
  <section class="section bg-champagne">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">{home.diensten.kicker}</p>
        <h2 class="sec-title">{home.diensten.titel}</h2>
      </div>
      <div class="services">
        {home.diensten.items.map((item, i) => (
          <a href={item.href} class="service reveal" style={`--reveal-delay:${i * 120}ms`}>
            <span class="service-num">{item.nummer}</span>
            <h3 class="service-title">{item.titel}</h3>
            <p class="service-text">{item.tekst}</p>
            <span class="link-more">Meer lezen <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- IMAGE BREAK / SIGNATURE QUOTE -->
  <section class="quote-break">
    <div class="quote-media" data-parallax data-speed="0.12">
      <Image
        src={handsImg}
        alt={home.citaat.afbeeldingAlt}
        widths={[768, 1280, 1800]}
        sizes="100vw"
        quality={68}
        format="webp"
        class="quote-img"
      />
    </div>
    <div class="quote-scrim"></div>
    <blockquote class="quote-content wrap reveal">
      <p class="quote-mark">&ldquo;</p>
      <p class="quote-text">{home.citaat.tekst}</p>
      <span class="rule center reveal-rule" style="--reveal-delay:200ms"></span>
      <cite class="quote-name">{home.citaat.naam}</cite>
    </blockquote>
  </section>

  <!-- OVER ANGELA -->
  <section class="section bg-cream">
    <div class="wrap about">
      <div class="about-media reveal">
        <div class="about-frame">
          <Image
            src={angelaImg}
            alt={home.over.afbeeldingAlt}
            widths={[480, 720, 960]}
            sizes="(max-width: 880px) 90vw, 440px"
            quality={78}
            format="webp"
            class="about-img"
          />
        </div>
        <span class="about-deco about-deco-tl" aria-hidden="true"></span>
        <span class="about-deco about-deco-br" aria-hidden="true"></span>
      </div>
      <div class="about-body">
        <p class="kicker reveal">{home.over.kicker}</p>
        <h2 class="about-title reveal" style="--reveal-delay:80ms">
          {home.over.titelRegels.map((r) => <span>{r}<br /></span>)}
        </h2>
        <span class="rule reveal-rule" style="--reveal-delay:160ms"></span>
        {home.over.alineas.map((p, i) => (
          <p class="about-p reveal" style={`--reveal-delay:${180 + i * 90}ms`}>{p}</p>
        ))}
        <a href={home.over.knop.href} class="btn btn-outline reveal" style="--reveal-delay:380ms">{home.over.knop.label} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- CIJFERS -->
  <section class="stats">
    <div class="wrap stats-grid">
      {home.cijfers.map((stat, i) => (
        <div class="stat reveal" style={`--reveal-delay:${i * 130}ms`}>
          <span class="stat-num">{stat.getal}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="reviews-showcase">
    <span class="rs-glow" aria-hidden="true"></span>
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker kicker-gold">{home.reviews.kicker}</p>
        <h2 class="sec-title rs-title">{home.reviews.titel}</h2>
        <p class="rs-intro">{home.reviews.intro}</p>
      </div>

      <div class="rs-stage reveal" data-reviews aria-roledescription="carousel" aria-label="Wat bruidsparen vertellen">
        <span class="rs-mark" aria-hidden="true">&ldquo;</span>
        <div class="rs-track">
          {featured.map((r, i) => (
            <figure class:list={['rs-slide', { active: i === 0 }]} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
              <blockquote class="rs-text">{r.quote}</blockquote>
              <figcaption class="rs-cite">
                <span class="rs-name">{r.naam}</span>
                <span class="rs-sep" aria-hidden="true">·</span>
                <span class="rs-date">{r.datum}</span>
              </figcaption>
            </figure>
          ))}
        </div>

        <div class="rs-controls">
          <button class="rs-arrow" type="button" data-prev aria-label="Vorige review"><span aria-hidden="true">&larr;</span></button>
          <div class="rs-dots" role="tablist" aria-label="Kies een review">
            {featured.map((_, i) => (
              <button class:list={['rs-dot', { active: i === 0 }]} type="button" data-dot aria-label={`Review ${i + 1} van ${featured.length}`} aria-selected={i === 0 ? 'true' : 'false'} role="tab"></button>
            ))}
          </div>
          <button class="rs-arrow" type="button" data-next aria-label="Volgende review"><span aria-hidden="true">&rarr;</span></button>
        </div>
      </div>

      <div class="rs-foot reveal">
        <a href={home.reviews.knop.href} class="link-more link-more-light">{home.reviews.knop.label} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- COACHING -->
  <section class="section bg-champagne">
    <div class="wrap about about-reverse">
      <div class="about-body">
        <p class="kicker reveal">{home.coaching.kicker}</p>
        <h2 class="coaching-title reveal" style="--reveal-delay:80ms">{home.coaching.titel}</h2>
        <span class="rule reveal-rule" style="--reveal-delay:160ms"></span>
        <p class="about-p reveal" style="--reveal-delay:180ms">{home.coaching.tekst}</p>
        <ul class="coaching-list">
          {home.coaching.punten.map((p, i) => (
            <li class="reveal" style={`--reveal-delay:${240 + i * 70}ms`}><span class="coaching-tick">✦</span>{p}</li>
          ))}
        </ul>
        <a href={home.coaching.knop.href} class="btn btn-outline reveal" style="--reveal-delay:540ms">{home.coaching.knop.label} <span class="arrow">→</span></a>
      </div>
      <div class="about-media reveal">
        <div class="about-frame">
          <Image
            src={coachingImg}
            alt={home.coaching.afbeeldingAlt}
            widths={[480, 720, 960]}
            sizes="(max-width: 880px) 90vw, 440px"
            quality={76}
            format="webp"
            class="about-img"
          />
        </div>
        <span class="about-deco about-deco-bl" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-cream cta">
    <div class="wrap wrap-narrow cta-inner reveal">
      <p class="kicker">{home.cta.kicker}</p>
      <h2 class="cta-title">{home.cta.titel}</h2>
      <div class="ornament cta-orn"><span>✦</span></div>
      <p class="cta-text">{home.cta.tekst}</p>
      <a href={home.cta.knop.href} class="btn btn-gold">{home.cta.knop.label} <span class="arrow">→</span></a>
    </div>
  </section>
</Base>

<style>
  /* Soft section seams: champagne sections blend into cream top & bottom */
  .bg-cream { background: var(--cream); }
  .bg-champagne {
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 9%, var(--cream-deep) 91%, var(--cream) 100%);
  }

  /* ===== HERO ===== */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-media { position: absolute; inset: -10% 0; z-index: -2; }
  .hero-media :global(img) { width: 100%; height: 120%; object-fit: cover; object-position: 50% 50%; }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(115% 92% at 50% 46%, hsl(30 38% 22% / 0.22) 8%, hsl(26 36% 11% / 0.72) 100%),
      linear-gradient(180deg, hsl(27 34% 12% / 0.55) 0%, hsl(28 28% 16% / 0.34) 42%, hsl(26 30% 9% / 0.68) 100%),
      linear-gradient(0deg, var(--cream) 0%, transparent 16%);
    mix-blend-mode: normal;
  }
  .hero-scrim::after {
    content: '';
    position: absolute;
    inset: 0;
    background: hsl(30 46% 19% / 0.42);
    mix-blend-mode: multiply;
  }
  .hero-content { text-align: center; color: var(--cream); max-width: 900px; }
  .hero-kicker {
    color: hsl(40 40% 92% / 0.85);
    margin-bottom: 1.75rem;
    opacity: 0;
    animation: fade-down 1.2s 0.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-title {
    color: var(--cream);
    font-weight: 500;
    font-size: clamp(2.75rem, 8vw, 5.75rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
  }
  .hero-title span { display: block; }
  .hero-line-1 { opacity: 0; animation: fade-up 1.1s 0.4s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .hero-line-2 { opacity: 0; animation: fade-up 1.1s 0.58s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
  .hero-line-2 em { font-style: italic; color: hsl(38 55% 78%); }
  .hero-rule {
    display: block;
    width: 70px; height: 1px;
    background: var(--gold-soft);
    margin: 1.9rem auto 1.6rem;
    transform: scaleX(0);
    animation: draw 1s 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-sub {
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.3rem);
    color: hsl(40 40% 94% / 0.92);
    font-weight: 300;
    letter-spacing: 0.02em;
    opacity: 0;
    animation: fade-up 1.1s 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2.5rem;
    opacity: 0;
    animation: fade-up 1.1s 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: hsl(40 40% 94% / 0.6);
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0;
    animation: fade-in 1.2s 1.6s ease forwards;
  }
  .hero-scroll-line { width: 1px; height: 44px; background: linear-gradient(hsl(40 40% 94% / 0.7), transparent); }

  @keyframes fade-up { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  @keyframes fade-down { from { opacity: 0; transform: translateY(-14px); } to { opacity: 1; transform: none; } }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes draw { to { transform: scaleX(1); } }

  @media (prefers-reduced-motion: reduce) {
    .hero-kicker, .hero-line-1, .hero-line-2, .hero-sub, .hero-actions, .hero-scroll { animation: none; opacity: 1; }
    .hero-rule { animation: none; transform: scaleX(1); }
  }

  /* ===== Shared section heads ===== */
  .sec-head { text-align: center; max-width: 640px; margin: 0 auto clamp(3rem, 5vw, 4.5rem); }
  .sec-head .kicker { margin-bottom: 0.9rem; }
  .sec-title { font-size: clamp(1.9rem, 1.4rem + 2vw, 3rem); }

  /* ===== INTRO ===== */
  .intro { text-align: center; }
  .intro .kicker { margin-bottom: 1.1rem; }
  .intro-title { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem); margin-bottom: 0.5rem; }
  .intro-orn { max-width: 90px; margin: 2rem auto; }
  .intro-p { color: var(--muted); margin-bottom: 1.4rem; font-size: 1.075rem; }
  .intro-p:last-child { margin-bottom: 0; }

  /* ===== DIENSTEN ===== */
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.5vw, 2rem); }
  .service {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: clamp(1.75rem, 3vw, 2.6rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 3px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease, border-color 0.5s ease;
  }
  .service:hover { transform: translateY(-6px); box-shadow: var(--shadow-lift); border-color: hsl(36 40% 75%); }
  .service-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--gold);
    letter-spacing: 0.05em;
  }
  .service-title { font-size: 1.4rem; }
  .service-text { color: var(--muted); font-size: 0.98rem; flex: 1; }
  .service .link-more { margin-top: 0.5rem; }

  /* ===== QUOTE BREAK ===== */
  .quote-break {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(6rem, 14vw, 11rem);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .quote-media { position: absolute; inset: -12% 0; z-index: -2; }
  .quote-media :global(img) { width: 100%; height: 124%; object-fit: cover; object-position: center 35%; }
  .quote-scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, var(--cream) -2%, transparent 12%, transparent 88%, var(--cream) 102%),
      hsl(26 28% 12% / 0.52);
  }
  .quote-content { text-align: center; color: var(--cream); max-width: 880px; }
  .quote-mark { font-family: var(--font-display); font-size: 4rem; line-height: 0.4; color: var(--gold-soft); margin-bottom: 1.5rem; }
  .quote-text {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.7rem, 1.2rem + 2.4vw, 3.1rem);
    line-height: 1.28;
    color: var(--white);
  }
  .quote-name {
    display: block;
    margin-top: 1.6rem;
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: hsl(40 40% 90% / 0.8);
  }
  .quote-content .rule { background: var(--gold-soft); margin-top: 1.4rem; }

  /* ===== ABOUT (shared with coaching) ===== */
  .about {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: center;
  }
  .about-reverse { grid-template-columns: 1fr 0.85fr; }
  .about-media { position: relative; }
  .about-frame { position: relative; overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 5; }
  .about-frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .about-media:hover .about-frame :global(img) { transform: scale(1.04); }
  .about-deco { position: absolute; width: 92px; height: 92px; border: 1px solid var(--gold); opacity: 0.5; }
  .about-deco-tl { top: -16px; left: -16px; border-right: 0; border-bottom: 0; }
  .about-deco-br { bottom: -16px; right: -16px; border-left: 0; border-top: 0; }
  .about-deco-bl { bottom: -16px; left: -16px; border-right: 0; border-top: 0; }
  .about-title, .coaching-title { font-size: clamp(1.9rem, 1.4rem + 2.2vw, 3.1rem); margin-bottom: 1.4rem; }
  .about-title { line-height: 1.08; }
  .about-body .rule { margin-bottom: 1.8rem; }
  .about-p { color: var(--muted); margin-bottom: 1.2rem; }
  .about-body .btn { margin-top: 1rem; }
  .about-body .kicker { margin-bottom: 1rem; }

  .coaching-list { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.7rem; }
  .coaching-list li { display: flex; align-items: baseline; gap: 0.8rem; color: var(--muted); font-size: 0.98rem; }
  .coaching-tick { color: var(--gold); font-size: 0.7rem; }

  /* ===== STATS ===== */
  .stats {
    position: relative;
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 50%, var(--cream) 100%);
    color: var(--brown);
    padding-block: clamp(3.25rem, 6vw, 5rem);
  }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; text-align: center; }
  .stat { display: flex; flex-direction: column; gap: 0.7rem; position: relative; }
  .stat:not(:last-child)::after {
    content: ''; position: absolute; right: -1rem; top: 18%; height: 64%; width: 1px;
    background: var(--line);
  }
  .stat-num { font-family: var(--font-display); font-size: clamp(2.4rem, 1.8rem + 2.5vw, 3.6rem); color: var(--gold); line-height: 1; }
  .stat-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

  /* ===== REVIEWS SHOWCASE ===== */
  .reviews-showcase {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background:
      linear-gradient(180deg, var(--cream) 0, transparent 96px),
      linear-gradient(0deg, var(--cream) 0, transparent 96px),
      radial-gradient(135% 115% at 50% -10%, hsl(28 28% 23%), hsl(26 30% 13%) 70%);
    color: var(--cream);
    padding-block: clamp(6.5rem, 6rem + 4vw, 8.5rem);
  }
  .rs-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(55% 45% at 50% 48%, hsl(38 55% 52% / 0.16), transparent 72%);
    pointer-events: none;
  }
  .reviews-showcase .sec-head { margin-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  .kicker-gold { color: var(--gold-soft); }
  .rs-title { color: var(--cream); }
  .rs-intro { color: hsl(40 26% 80% / 0.85); margin-top: 1.1rem; font-size: 1.05rem; }

  .rs-stage { position: relative; max-width: 880px; margin-inline: auto; text-align: center; }
  .rs-mark {
    position: absolute;
    top: -3.5rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: 9rem;
    line-height: 1;
    color: var(--gold);
    opacity: 0.22;
    pointer-events: none;
  }
  .rs-track { position: relative; }
  :global(.js) .rs-track { display: grid; align-items: start; }
  .rs-slide { margin: 0; }
  .rs-slide + .rs-slide { margin-top: 2.5rem; }
  :global(.js) .rs-slide {
    grid-area: 1 / 1;
    margin-top: 0;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.45s ease, transform 0.45s ease;
    pointer-events: none;
  }
  :global(.js) .rs-slide.active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.3s, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
  }
  .rs-text {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.45rem, 1.05rem + 1.9vw, 2.5rem);
    line-height: 1.4;
    color: var(--white);
    margin: 0;
  }
  .rs-cite {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.9rem;
    font-style: normal;
  }
  .rs-name { font-family: var(--font-display); font-size: 1.12rem; color: var(--gold-soft); }
  .rs-sep { color: hsl(40 30% 70% / 0.45); }
  .rs-date { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: hsl(40 26% 78% / 0.7); }

  .rs-controls { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-top: clamp(2.5rem, 4vw, 3.5rem); }
  :global(html:not(.js)) .rs-controls { display: none; }
  .rs-arrow {
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid hsl(40 30% 80% / 0.28);
