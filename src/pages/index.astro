---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import home from '../content/home.json';
import reviews from '../content/reviews.json';
import site from '../content/site.json';

import heroImg from '../assets/couple-hero.jpg';
import coupleJoy from '../assets/couple-joy.jpg';
import coupleBeach from '../assets/couple-beach.jpg';
import angelaCandid from '../assets/angela-candid.jpg';
import angelaWerk from '../assets/angela-werk.png';
import beloofteImg from '../assets/ring-exchange.jpg';
import handsImg from '../assets/hands-rings.jpg';
import aisleImg from '../assets/aisle-candles.jpg';

const featured = reviews.filter((r) => r.uitgelicht);
const gallery: Record<string, ImageMetadata> = {
  'couple-joy': coupleJoy,
  'couple-beach': coupleBeach,
  'hands-rings': handsImg,
  'aisle-candles': aisleImg,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.naam,
  description:
    'Persoonlijke trouwceremonies door Angela Bhagole-Mangre. Trouwambtenaar (BABS) en ceremoniespreker in Rotterdam, werkzaam door heel Nederland.',
  url: 'https://angelaceremonies.com',
  telephone: site.telefoonLink,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Rotterdam', addressCountry: 'NL' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  priceRange: '€€',
  founder: { '@type': 'Person', name: site.persoon },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '5', reviewCount: String(reviews.length), bestRating: '5' },
};
---

<Base
  title="Trouwambtenaar Rotterdam | Angela Ceremonies"
  description="Persoonlijke trouwceremonies door Angela Bhagole-Mangre. BABS & ceremoniespreker in Rotterdam, werkzaam in heel Nederland."
  canonical="/"
  ogImage="/og/home.jpg"
  jsonLd={jsonLd}
  darkHero
>
  <!-- HERO (full-bleed, foto-forward) -->
  <section class="hero">
    <div class="hero-media" data-parallax data-speed="0.1">
      <Image src={heroImg} alt={home.hero.afbeeldingAlt} widths={[768, 1280, 1920]} sizes="100vw" fetchpriority="high" loading="eager" quality={72} format="webp" />
    </div>
    <div class="hero-scrim"></div>
    <div class="wrap hero-inner">
      <a href={home.hero.ratingHref} class="hero-rating he" style="--d:120ms"><span class="stars" aria-hidden="true">★★★★★</span> {home.hero.rating}</a>
      <h1 class="hero-title">
        <span class="he" style="--d:240ms">{home.hero.titel}</span>
        <span class="he" style="--d:380ms"><em>{home.hero.titelAccent}</em></span>
      </h1>
      <p class="hero-sub he" style="--d:540ms">{home.hero.subtitel}</p>
      <div class="hero-actions he" style="--d:660ms">
        <a href={home.hero.knop.href} class="btn btn-gold">{home.hero.knop.label} <span class="arrow">→</span></a>
      </div>
    </div>
    <a href="#statement" class="hero-scroll" aria-label="Scroll naar beneden"><span>Scroll</span><span class="hero-scroll-line"></span></a>
  </section>

  <!-- STATEMENT -->
  <section class="section bg-cream statement" id="statement">
    <div class="wrap wrap-narrow statement-inner reveal">
      <p class="statement-text rich" set:html={home.statement.html}></p>
      <a href={home.statement.knop.href} class="btn btn-gold statement-btn">{home.statement.knop.label} <span class="arrow">→</span></a>
    </div>
  </section>

  <!-- VIDEO / ACHTER DE SCHERMEN -->
  <section class="video-section">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker kicker-gold">{home.video.kicker}</p>
        <h2 class="sec-title video-title">{home.video.titel}</h2>
        <p class="video-intro">{home.video.intro}</p>
      </div>
      <div class="video-frame reveal">
        <span class="video-play" aria-hidden="true">▶</span>
        <span class="video-label">{home.video.placeholderLabel}</span>
        <span class="video-soon">Video volgt</span>
      </div>
    </div>
  </section>

  <!-- HI, IK BEN ANGELA (split) -->
  <section class="section bg-cream">
    <div class="wrap feature">
      <div class="feature-media reveal">
        <div class="feature-frame">
          <Image src={angelaCandid} alt={home.intro.afbeeldingAlt} widths={[480, 760, 1000]} sizes="(max-width: 900px) 90vw, 480px" quality={80} format="webp" />
        </div>
        <span class="feature-deco" aria-hidden="true"></span>
      </div>
      <div class="feature-body reveal" style="--reveal-delay:120ms">
        <p class="kicker">{home.intro.kicker}</p>
        <h2 class="feature-title">{home.intro.titel} <em>{home.intro.titelAccent}</em></h2>
        <div class="prose rich">
          {home.intro.html.map((p) => <p set:html={p}></p>)}
        </div>
        <p class="signature script">{home.intro.signatuur}</p>
        <a href={home.intro.knop.href} class="btn btn-outline">{home.intro.knop.label} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- BELOFTE (overlap panel) -->
  <section class="section bg-champagne">
    <div class="wrap overlap reveal">
      <div class="overlap-media">
        <Image src={beloofteImg} alt={home.belofte.afbeeldingAlt} widths={[480, 800, 1100]} sizes="(max-width: 900px) 90vw, 600px" quality={76} format="webp" />
      </div>
      <div class="overlap-panel">
        <p class="kicker kicker-gold">{home.belofte.kicker}</p>
        <h2 class="overlap-title">{home.belofte.titel}</h2>
        <p class="overlap-text rich" set:html={home.belofte.html}></p>
      </div>
    </div>
  </section>

  <!-- DIENSTEN -->
  <section class="section bg-cream">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">{home.diensten.kicker}</p>
        <h2 class="sec-title">{home.diensten.titel}</h2>
      </div>
      <div class="services">
        {home.diensten.items.map((item, i) => (
          <a href={item.href} class="service reveal" style={`--reveal-delay:${i * 120}ms`}>
            <span class="service-num">{item.nummer}</span>
            <h3 class="service-title">{item.titel}</h3>
            <p class="service-text">{item.tekst}</p>
            <span class="link-more">Meer lezen <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WERKWIJZE (split reversed) -->
  <section class="section bg-champagne" id="werkwijze">
    <div class="wrap feature feature-reverse">
      <div class="feature-body reveal">
        <p class="kicker">{home.werkwijze.kicker}</p>
        <h2 class="feature-title">{home.werkwijze.titel}</h2>
        <p class="prose-intro">{home.werkwijze.intro}</p>
        <ol class="steps-list">
          {home.werkwijze.stappen.map((s, i) => (
            <li class="step-item reveal" style={`--reveal-delay:${120 + i * 90}ms`}>
              <span class="step-num">{s.nummer}</span>
              <div><h3 class="step-title">{s.titel}</h3><p class="step-text">{s.tekst}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="feature-media reveal" style="--reveal-delay:120ms">
        <div class="feature-frame">
          <Image src={angelaWerk} alt={home.werkwijze.afbeeldingAlt} widths={[480, 760, 1000]} sizes="(max-width: 900px) 90vw, 460px" quality={78} format="webp" />
        </div>
        <span class="feature-deco feature-deco-left" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- UITGELICHTE REVIEW (foto + overlap panel) -->
  <section class="section bg-cream">
    <div class="wrap overlap overlap-review reveal">
      <div class="overlap-media">
        <PlaceholderImage label={home.uitgelichteReview.fotoLabel} vorm="liggend" />
      </div>
      <div class="overlap-panel overlap-panel-review">
        <span class="review-stars" aria-hidden="true">★★★★★</span>
        <blockquote class="overlap-quote rich" set:html={home.uitgelichteReview.quoteHtml}></blockquote>
        <p class="overlap-cite">{home.uitgelichteReview.naam} <span class="overlap-date">· {home.uitgelichteReview.datum}</span></p>
      </div>
    </div>
  </section>

  <!-- REVIEWS SHOWCASE -->
  <section class="reviews-showcase">
    <span class="rs-glow" aria-hidden="true"></span>
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker kicker-gold">{home.reviews.kicker}</p>
        <h2 class="sec-title rs-title">{home.reviews.titel}</h2>
        <p class="rs-intro">{home.reviews.intro}</p>
      </div>
      <div class="rs-stage reveal" data-reviews aria-roledescription="carousel" aria-label="Wat bruidsparen vertellen">
        <span class="rs-mark" aria-hidden="true">&ldquo;</span>
        <div class="rs-track">
          {featured.map((r, i) => (
            <figure class:list={['rs-slide', { active: i === 0 }]} data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
              <blockquote class="rs-text">{r.quote}</blockquote>
              <figcaption class="rs-cite"><span class="rs-name">{r.naam}</span><span class="rs-sep" aria-hidden="true">·</span><span class="rs-date">{r.datum}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="rs-controls">
          <button class="rs-arrow" type="button" data-prev aria-label="Vorige review"><span aria-hidden="true">&larr;</span></button>
          <div class="rs-dots" role="tablist" aria-label="Kies een review">
            {featured.map((_, i) => (<button class:list={['rs-dot', { active: i === 0 }]} type="button" data-dot aria-label={`Review ${i + 1} van ${featured.length}`} aria-selected={i === 0 ? 'true' : 'false'} role="tab"></button>))}
          </div>
          <button class="rs-arrow" type="button" data-next aria-label="Volgende review"><span aria-hidden="true">&rarr;</span></button>
        </div>
      </div>
      <div class="rs-foot reveal"><a href={home.reviews.knop.href} class="link-more link-more-light">{home.reviews.knop.label} <span class="arrow">→</span></a></div>
    </div>
  </section>

  <!-- MOMENTEN (edge-to-edge galerij) -->
  <section class="momenten">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="kicker">{home.momenten.kicker}</p>
        <h2 class="sec-title">{home.momenten.titel}</h2>
      </div>
    </div>
    <div class="gallery-bleed reveal">
      {home.momenten.items.map((item) => (
        <div class="gb-item">
          {item.placeholder ? (
            <PlaceholderImage label={item.label} vorm="vierkant" />
          ) : (
            <div class="gb-frame"><Image src={gallery[item.bron]} alt={item.alt} widths={[400, 640, 760]} sizes="(max-width: 700px) 50vw, 33vw" quality={74} format="webp" /></div>
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- CIJFERS -->
  <section class="stats">
    <div class="wrap stats-grid">
      {home.cijfers.map((stat, i) => (
        <div class="stat reveal" style={`--reveal-delay:${i * 130}ms`}>
          <span class="stat-num">{stat.getal}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- COACHING (slim band) -->
  <section class="section bg-champagne coaching-band">
    <div class="wrap coaching-inner reveal">
      <div class="coaching-copy">
        <p class="kicker">{home.coaching.kicker}</p>
        <h2 class="coaching-title">{home.coaching.titel}</h2>
        <p class="coaching-text">{home.coaching.tekst}</p>
      </div>
      <a href={home.coaching.knop.href} class="btn btn-outline">{home.coaching.knop.label} <span class="arrow">→</span></a>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-cream cta">
    <div class="wrap wrap-narrow cta-inner reveal">
      <p class="kicker">{home.cta.kicker}</p>
      <h2 class="cta-title rich" set:html={home.cta.titelHtml}></h2>
      <div class="ornament cta-orn"><span>✦</span></div>
      <p class="cta-text">{home.cta.tekst}</p>
      <div class="cta-actions">
        <a href={home.cta.knop.href} class="btn btn-gold">{home.cta.knop.label} <span class="arrow">→</span></a>
        <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-outline" data-hb-goal="whatsapp">WhatsApp Angela</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .bg-cream { background: var(--cream); }
  .bg-champagne { background: linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 9%, var(--cream-deep) 91%, var(--cream) 100%); }

  /* ===== HERO ===== */
  .hero { position: relative; min-height: 96svh; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; padding-bottom: clamp(3.5rem, 8vw, 7rem); }
  .hero-media { position: absolute; inset: -8% 0; z-index: -2; }
  .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 46%; }
  .hero-scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, hsl(26 30% 10% / 0.34) 0%, hsl(26 28% 12% / 0.08) 26%, hsl(26 30% 10% / 0.26) 56%, hsl(26 32% 8% / 0.72) 100%), linear-gradient(0deg, var(--cream) -1%, transparent 14%); }
  .hero-inner { color: var(--cream); max-width: 940px; text-align: center; margin-inline: auto; }
  .hero-rating { display: inline-flex; align-items: center; gap: 0.55rem; color: hsl(40 40% 94% / 0.92); text-decoration: none; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.6rem; }
  .hero-rating .stars { color: var(--gold-soft); letter-spacing: 0.1em; font-size: 0.92rem; }
  .hero-rating:hover { color: var(--cream); }
  .hero-title { color: var(--cream); font-weight: 400; font-size: clamp(2.8rem, 2rem + 5vw, 6rem); line-height: 1.02; letter-spacing: -0.02em; }
  .hero-title span { display: block; }
  .hero-title em { font-style: italic; color: hsl(38 58% 82%); }
  .hero-sub { margin: 1.6rem auto 0; font-size: clamp(1.05rem, 1rem + 0.5vw, 1.35rem); font-weight: 300; line-height: 1.6; color: hsl(40 40% 95% / 0.94); max-width: 40ch; }
  .hero-actions { margin-top: 2.3rem; }
  .hero-scroll { position: absolute; bottom: 1.4rem; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 0.55rem; text-decoration: none; color: hsl(40 40% 94% / 0.55); font-size: 0.62rem; letter-spacing: 0.24em; text-transform: uppercase; }
  .hero-scroll-line { width: 1px; height: 38px; background: linear-gradient(hsl(40 40% 94% / 0.6), transparent); }
  .he { opacity: 0; animation: he-up 1s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) forwards; }
  @keyframes he-up { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .he { opacity: 1; animation: none; } }

  /* ===== shared heads ===== */
  .sec-head { text-align: center; max-width: 660px; margin: 0 auto clamp(3rem, 5vw, 4.5rem); }
  .sec-head .kicker { margin-bottom: 0.9rem; }
  .sec-title { font-size: clamp(1.9rem, 1.4rem + 2vw, 3rem); font-weight: 400; }
  .kicker-gold { color: var(--gold-soft); }

  /* ===== STATEMENT ===== */
  .statement-inner { text-align: center; }
  .statement-text { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.5rem, 1.1rem + 2vw, 2.7rem); line-height: 1.36; color: var(--ink); }
  .statement-text :global(em) { color: var(--gold); font-style: italic; }
  .statement-text :global(strong) { color: var(--ink); font-weight: 700; }
  .statement-btn { margin-top: 2.2rem; }

  /* ===== VIDEO ===== */
  .video-section { background: radial-gradient(130% 120% at 50% 0%, hsl(28 28% 22%), hsl(26 30% 13%)); color: var(--cream); padding-block: clamp(4.5rem, 9vw, 7.5rem); }
  .video-title { color: var(--cream); }
  .video-intro { color: hsl(40 26% 80% / 0.85); margin-top: 1rem; font-style: italic; font-family: var(--font-display); font-size: 1.15rem; }
  .video-frame { position: relative; max-width: 900px; margin-inline: auto; aspect-ratio: 16 / 9; border-radius: 4px; border: 1px solid hsl(40 30% 80% / 0.2); background: repeating-linear-gradient(135deg, hsl(26 28% 16%) 0 14px, hsl(26 28% 18%) 14px 28px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.9rem; }
  .video-play { width: 68px; height: 68px; border-radius: 50%; display: grid; place-items: center; background: var(--gold); color: hsl(26 30% 14%); font-size: 1.3rem; padding-left: 4px; }
  .video-label { font-family: var(--font-display); font-style: italic; font-size: 1.1rem; color: hsl(40 30% 86%); }
  .video-soon { font-size: 0.66rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-soft); }

  /* ===== FEATURE SPLIT ===== */
  .feature { display: grid; grid-template-columns: 0.92fr 1fr; gap: clamp(2.5rem, 6vw, 5.5rem); align-items: center; }
  .feature-reverse { grid-template-columns: 1fr 0.92fr; }
  .feature-media { position: relative; }
  .feature-frame { overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 5; }
  .feature-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .feature-media:hover .feature-frame :global(img) { transform: scale(1.04); }
  .feature-deco { position: absolute; width: 90px; height: 90px; border: 1px solid var(--gold); opacity: 0.5; bottom: -16px; right: -16px; border-left: 0; border-top: 0; }
  .feature-deco-left { right: auto; left: -16px; border-left: 1px solid var(--gold); border-right: 0; border-top: 0; }
  .feature-body .kicker { margin-bottom: 1rem; }
  .feature-title { font-size: clamp(2rem, 1.5rem + 2.2vw, 3.2rem); font-weight: 400; line-height: 1.08; margin-bottom: 1.5rem; }
  .feature-title em { font-style: italic; color: var(--gold); }
  .prose p { color: var(--muted); margin-bottom: 1.2rem; line-height: 1.85; }
  .prose-intro { color: var(--muted); margin-bottom: 1.6rem; line-height: 1.8; }
  .signature { font-size: 2.6rem; color: var(--gold); line-height: 1; margin: 0.4rem 0 1.6rem; }

  /* ===== OVERLAP PANEL ===== */
  .overlap { display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: center; }
  .overlap-media { grid-column: 1; grid-row: 1; z-index: 1; overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 3 / 2; }
  .overlap-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .overlap-media :global(.ph-img) { height: 100%; }
  .overlap-panel { grid-column: 2; grid-row: 1; z-index: 2; margin-left: -16%; background: var(--ink); color: var(--cream); padding: clamp(2rem, 4vw, 3.25rem); border-radius: 3px; box-shadow: var(--shadow-lift); }
  .overlap-panel .kicker-gold { margin-bottom: 0.9rem; }
  .overlap-title { color: var(--cream); font-weight: 400; font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.5rem); line-height: 1.12; margin-bottom: 1.2rem; }
  .overlap-text { color: hsl(40 26% 84% / 0.92); line-height: 1.8; font-size: 1.05rem; }
  .overlap-text :global(em) { color: var(--gold-soft); font-style: italic; }
  .overlap-text :global(strong) { color: var(--cream); font-weight: 700; }
  .review-stars { color: var(--gold-soft); font-size: 1rem; letter-spacing: 0.15em; }
  .overlap-quote { color: var(--white); font-family: var(--font-display); font-style: italic; font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.9rem); line-height: 1.4; margin: 1rem 0 1.4rem; }
  .overlap-quote :global(em) { color: var(--gold-soft); }
  .overlap-quote :global(strong) { color: var(--white); font-weight: 600; font-style: normal; }
  .overlap-cite { font-family: var(--font-display); font-size: 1.1rem; color: var(--gold-soft); }
  .overlap-date { color: hsl(40 26% 78% / 0.7); font-size: 0.9rem; }

  /* ===== DIENSTEN ===== */
  .services { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1rem, 2.5vw, 2rem); }
  .service { display: flex; flex-direction: column; align-items: flex-start; gap: 0.85rem; padding: clamp(1.75rem, 3vw, 2.6rem); background: var(--white); border: 1px solid var(--line); border-radius: 3px; text-decoration: none; color: inherit; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease, border-color 0.5s ease; }
  .service:hover { transform: translateY(-6px); box-shadow: var(--shadow-lift); border-color: hsl(36 40% 75%); }
  .service-num { font-family: var(--font-display); font-style: italic; font-size: 1.05rem; color: var(--gold); }
  .service-title { font-size: 1.4rem; font-weight: 400; }
  .service-text { color: var(--muted); font-size: 0.98rem; flex: 1; line-height: 1.7; }

  /* ===== WERKWIJZE STEPS ===== */
  .steps-list { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; flex-direction: column; gap: 1.5rem; }
  .step-item { display: flex; gap: 1.1rem; align-items: flex-start; }
  .step-num { font-family: var(--font-display); font-size: 1.4rem; color: var(--gold); line-height: 1; flex: none; padding-top: 0.15rem; min-width: 2ch; }
  .step-title { font-size: 1.2rem; font-weight: 400; margin-bottom: 0.35rem; }
  .step-text { color: var(--muted); font-size: 0.97rem; line-height: 1.7; }

  /* ===== REVIEWS SHOWCASE ===== */
  .reviews-showcase { position: relative; overflow: hidden; isolation: isolate; background: linear-gradient(180deg, var(--cream) 0, transparent 96px), linear-gradient(0deg, var(--cream) 0, transparent 96px), radial-gradient(135% 115% at 50% -10%, hsl(28 28% 23%), hsl(26 30% 13%) 70%); color: var(--cream); padding-block: clamp(6.5rem, 6rem + 4vw, 8.5rem); }
