---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import lw from '../content/teksten/lieve-woorden.json';
import reviews from '../content/reviews.json';
import heroImg from '../assets/candles-roses.jpg';
import featuredImg from '../assets/couple-beach.jpg';

const featured = reviews.find((r) => r.uitgelicht) ?? reviews[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Angela Ceremonies',
  url: 'https://angelaceremonies.com',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5',
    reviewCount: String(reviews.length),
    bestRating: '5',
  },
  review: reviews.slice(0, 8).map((r) => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    author: { '@type': 'Person', name: r.naam },
    reviewBody: r.quote,
  })),
};
---

<Base title={lw.meta.title} description={lw.meta.description} canonical="/lieve-woorden" jsonLd={jsonLd}>
  <PageHero
    kicker={lw.hero.kicker}
    title={lw.hero.titel}
    titleAccent={lw.hero.titelAccent}
    subtitle={lw.hero.subtitel}
    image={heroImg}
    imageAlt="Witte rozen en kaarsen bij een ceremonie"
    objectPosition="50% 45%"
  />

  <section class="section bg-cream">
    <figure class="wrap review-row reveal">
      <div class="rr-media">
        <Image src={featuredImg} alt="Stralend bruidspaar op hun trouwdag" widths={[480, 800, 1100]} sizes="(max-width: 900px) 90vw, 540px" quality={78} format="webp" />
      </div>
      <figcaption class="rr-body">
        <span class="rr-stars" aria-hidden="true">★★★★★</span>
        <blockquote class="rr-quote">{featured.quote}</blockquote>
        <p class="rr-cite">{featured.naam} <span class="rr-date">· {featured.datum}</span></p>
      </figcaption>
    </figure>
  </section>

  <section class="section bg-champagne">
    <div class="wrap">
      <p class="lw-intro rich reveal" set:html={lw.intro.tekst}></p>

      <div class="lw-wall">
        {reviews.map((r, i) => (
          <figure class="lw-card reveal" style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <p class="lw-mark" aria-hidden="true">&ldquo;</p>
            <blockquote class="lw-quote">{r.quote}</blockquote>
            <figcaption class="lw-cite">
              <span class="lw-name">{r.naam}</span>
              <span class="lw-date">{r.datum}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CtaSection
    kicker={lw.cta.kicker}
    title={lw.cta.titel}
    text={lw.cta.tekst}
    buttonLabel={lw.cta.knopLabel}
    buttonHref={lw.cta.knopHref}
  />
</Base>

<style>
  .review-row { display: grid; grid-template-columns: 1.02fr 0.98fr; gap: clamp(2.25rem, 5vw, 4.5rem); align-items: center; margin: 0; }
  .rr-media { overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 5; }
  .rr-media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1); }
  .review-row:hover .rr-media :global(img) { transform: scale(1.04); }
  .rr-body { max-width: 40ch; }
  .rr-stars { color: var(--gold-soft); font-size: 1.05rem; letter-spacing: 0.18em; }
  .rr-quote { margin: 1.1rem 0 1.6rem; font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.2rem); line-height: 1.4; color: var(--ink); }
  .rr-cite { font-family: var(--font-display); font-size: 1.2rem; color: var(--gold); }
  .rr-date { color: var(--muted); font-size: 0.82rem; font-family: var(--font-body); }
  @media (max-width: 900px) {
    .review-row { grid-template-columns: 1fr; gap: 2rem; }
    .rr-media { aspect-ratio: 3 / 2; }
    .rr-body { max-width: none; }
  }

  .lw-intro {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(3rem, 5vw, 4.5rem);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 1.05rem + 1vw, 1.7rem);
    line-height: 1.45;
    color: var(--ink);
  }
  .lw-wall { columns: 3; column-gap: clamp(1rem, 2.5vw, 1.75rem); }
  .lw-card {
    break-inside: avoid;
    margin: 0 0 clamp(1rem, 2.5vw, 1.75rem);
    padding: clamp(1.5rem, 2.5vw, 2.1rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 3px;
    box-shadow: var(--shadow-soft);
  }
  .lw-card:nth-child(4n) { border-top: 2px solid var(--gold); }
  .lw-mark { font-family: var(--font-display); font-size: 2.4rem; line-height: 0.4; color: var(--gold); margin-bottom: 1rem; opacity: 0.7; }
  .lw-quote { margin: 0 0 1.25rem; color: var(--brown); font-size: 0.98rem; line-height: 1.65; }
  .lw-cite { display: flex; flex-direction: column; gap: 0.15rem; }
  .lw-name { font-family: var(--font-display); font-size: 1.08rem; color: var(--ink); }
  .lw-date { font-size: 0.72rem; letter-spacing: 0.08em; color: var(--gold); }

  @media (max-width: 900px) { .lw-wall { columns: 2; } }
  @media (max-width: 600px) { .lw-wall { columns: 1; } }
</style>
