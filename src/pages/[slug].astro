---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaSection from '../components/CtaSection.astro';
import paginas from '../content/seo-paginas.json';
import type { ImageMetadata } from 'astro';
import rotterdamImg from '../assets/hero-ceremony.jpg';
import denhaagImg from '../assets/aisle-candles.jpg';
import babsImg from '../assets/hands-rings.jpg';
import ceremonieelImg from '../assets/candles-roses.jpg';
import kostenImg from '../assets/ring-exchange.jpg';

const heroImages: Record<string, { src: ImageMetadata; alt: string; pos: string }> = {
  'trouwambtenaar-rotterdam': { src: rotterdamImg, alt: 'Warme kaarslicht-setting bij een trouwceremonie', pos: '50% 60%' },
  'trouwambtenaar-den-haag': { src: denhaagImg, alt: 'Kaarsen en bloemen bij een ceremonie', pos: '50% 50%' },
  'babs-inhuren': { src: babsImg, alt: 'Handen van een bruidspaar tijdens de ringuitwisseling', pos: '50% 40%' },
  'ceremonieel-trouwen': { src: ceremonieelImg, alt: 'Witte rozen en kaarsen bij een ceremonie', pos: '50% 45%' },
  'trouwambtenaar-kosten': { src: kostenImg, alt: 'Intiem moment tijdens de ringuitwisseling', pos: '50% 45%' },
};

export function getStaticPaths() {
  return paginas.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const hero = heroImages[p.slug];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Angela Ceremonies',
    description: p.meta.description,
    url: `https://angelaceremonies.com/${p.slug}`,
    telephone: '+31624897676',
    email: 'angela.bhagole@gmail.com',
    address: { '@type': 'PostalAddress', addressLocality: 'Rotterdam', addressCountry: 'NL' },
    areaServed: { '@type': 'Country', name: 'Nederland' },
  },
];

if ('faq' in p && Array.isArray(p.faq) && p.faq.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faq.map((f: { vraag: string; antwoord: string }) => ({
      '@type': 'Question',
      name: f.vraag,
      acceptedAnswer: { '@type': 'Answer', text: f.antwoord },
    })),
  });
}
---

<Base title={p.meta.title} description={p.meta.description} canonical={`/${p.slug}`} jsonLd={jsonLd}>
  <PageHero
    kicker={p.hero.kicker}
    title={p.hero.titel}
    titleAccent={p.hero.titelAccent}
    subtitle={p.hero.subtitel}
    image={hero?.src}
    imageAlt={hero?.alt}
    objectPosition={hero?.pos}
  />

  {p.sections.map((s: any, i: number) => (
    <section class:list={['section', i % 2 === 0 ? 'bg-cream' : 'bg-champagne']}>
      <div class="wrap">
        <div class="seo-block">
          <h2 class="seo-heading reveal">{s.heading}</h2>
          <span class="rule center reveal-rule" style="--reveal-delay:120ms"></span>
          {s.paragraphs && (
            <div class="prose seo-prose reveal" style="--reveal-delay:160ms">
              {s.paragraphs.map((para: string) => <p>{para}</p>)}
            </div>
          )}
          {s.checklist && (
            <ul class="checklist seo-checklist reveal" style="--reveal-delay:160ms">
              {s.checklist.map((item: string) => <li>{item}</li>)}
            </ul>
          )}
        </div>

        {s.cards && (
          <div class="cards-2 seo-cards">
            {s.cards.map((card: { titel: string; tekst: string }, ci: number) => (
              <article class="value-card reveal" style={`--reveal-delay:${ci * 100}ms`}>
                <span class="value-orn" aria-hidden="true">✦</span>
                <h3>{card.titel}</h3>
                <p>{card.tekst}</p>
              </article>
            ))}
          </div>
        )}

        {s.buttons && (
          <div class="seo-buttons reveal">
            {s.buttons.map((b: { label: string; href: string; variant?: string }) => (
              <a href={b.href} class:list={['btn', b.variant === 'gold' ? 'btn-gold' : 'btn-outline']}>{b.label} <span class="arrow">→</span></a>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  {'faq' in p && Array.isArray(p.faq) && p.faq.length > 0 && (
    <section class:list={['section', p.sections.length % 2 === 0 ? 'bg-cream' : 'bg-champagne']}>
      <div class="wrap">
        <div class="section-head reveal">
          <p class="kicker">Veelgestelde vragen</p>
          <h2 class="section-title">Goed om te weten</h2>
        </div>
        <div class="faq">
          {p.faq.map((f: { vraag: string; antwoord: string }, fi: number) => (
            <div class="faq-item reveal" style={`--reveal-delay:${fi * 80}ms`}>
              <h3>{f.vraag}</h3>
              <p>{f.antwoord}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaSection
    kicker={p.cta.kicker}
    title={p.cta.titel}
    text={p.cta.tekst}
    buttonLabel={p.cta.knopLabel}
    buttonHref={p.cta.knopHref}
  />
</Base>

<style>
  .seo-block { max-width: 760px; margin-inline: auto; text-align: center; }
  .seo-heading { font-size: clamp(1.7rem, 1.3rem + 1.8vw, 2.6rem); }
  .seo-block .rule { margin: 1.5rem auto 2rem; }
  .seo-prose { text-align: left; }
  .seo-prose p { font-size: 1.04rem; }
  .seo-checklist { text-align: left; max-width: 520px; margin-inline: auto; gap: 1rem; }
  .seo-checklist li { font-size: 1.02rem; }
  .seo-cards { max-width: 860px; margin: clamp(2.5rem, 4vw, 3.5rem) auto 0; }
  .seo-buttons { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-top: clamp(2.5rem, 4vw, 3.5rem); }
</style>
