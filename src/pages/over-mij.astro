---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaSection from '../components/CtaSection.astro';
import PageHero from '../components/PageHero.astro';
import o from '../content/teksten/over-mij.json';
import angelaImg from '../assets/angela-toga.jpg';
import angelaWarm from '../assets/angela-warm.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Angela Bhagole-Mangre',
  jobTitle: 'Buitengewoon Ambtenaar van de Burgerlijke Stand (BABS) & ceremoniespreker',
  worksFor: { '@type': 'ProfessionalService', name: 'Angela Ceremonies' },
  address: { '@type': 'PostalAddress', addressLocality: 'Rotterdam', addressCountry: 'NL' },
  description: o.meta.description,
};
---

<Base title={o.meta.title} description={o.meta.description} canonical="/over-mij" jsonLd={jsonLd}>
  <PageHero
    kicker={o.hero.kicker}
    title={o.hero.titel}
    titleAccent={o.hero.titelAccent}
    subtitle={o.hero.subtitel}
    portrait={angelaWarm}
    portraitAlt="Angela Bhagole-Mangre, trouwambtenaar en ceremoniespreker"
    portraitPosition="50% 18%"
  />

  <section class="section bg-cream">
    <div class="wrap split">
      <div class="bio-media reveal">
        <div class="bio-frame">
          <Image src={angelaImg} alt={o.bio.afbeeldingAlt} widths={[480, 720, 960]} sizes="(max-width: 880px) 90vw, 460px" quality={80} format="webp" />
        </div>
        <span class="bio-deco" aria-hidden="true"></span>
      </div>
      <div class="split-text bio-body">
        <p class="kicker reveal">{o.bio.kicker}</p>
        <h2 class="bio-name reveal" style="--reveal-delay:80ms">{o.bio.naam}</h2>
        <p class="bio-role reveal" style="--reveal-delay:120ms">{o.bio.rol}</p>
        <span class="rule reveal-rule" style="--reveal-delay:160ms"></span>
        <div class="prose rich">
          {o.bio.alineas.map((p, i) => <p class="reveal" style={`--reveal-delay:${180 + i * 80}ms`} set:html={p}></p>)}
        </div>
        <blockquote class="bio-quote reveal">{o.bio.citaat}</blockquote>
        <p class="bio-signature script reveal" aria-hidden="true">Angela</p>
        <a href={o.bio.profielHref} target="_blank" rel="noopener" class="link-more reveal">{o.bio.profielLabel} <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="section bg-champagne">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="kicker">{o.waarden.kicker}</p>
        <h2 class="section-title">{o.waarden.titel}</h2>
      </div>
      <div class="cards-3">
        {o.waarden.items.map((item, i) => (
          <article class="value-card reveal" style={`--reveal-delay:${i * 120}ms`}>
            <span class="value-orn" aria-hidden="true">✦</span>
            <h3>{item.titel}</h3>
            <p>{item.tekst}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="stats-band">
    <div class="wrap stats-grid">
      {o.cijfers.map((stat) => (
        <div class="stat reveal">
          <span class="stat-num">{stat.getal}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </section>

  <CtaSection
    kicker={o.cta.kicker}
    title={o.cta.titel}
    text={o.cta.tekst}
    buttonLabel={o.cta.knopLabel}
    buttonHref={o.cta.knopHref}
  />
</Base>

<style>
  .bio-media { position: relative; }
  .bio-frame { overflow: hidden; border-radius: 3px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 5; }
  .bio-frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 22%; }
  .bio-deco { position: absolute; width: 92px; height: 92px; border: 1px solid var(--gold); opacity: 0.5; bottom: -16px; right: -16px; border-left: 0; border-top: 0; }
  .bio-body .kicker { margin-bottom: 1rem; }
  .bio-name { font-size: clamp(2rem, 1.5rem + 2vw, 2.9rem); }
  .bio-role { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold); margin-top: 0.5rem; }
  .bio-body .rule { margin: 1.5rem 0 1.8rem; }
  .bio-signature { font-size: 2.6rem; color: var(--gold); line-height: 1; margin: 0.2rem 0 1.4rem; }
  .bio-quote {
    margin: 1.8rem 0;
    padding-left: 1.4rem;
    border-left: 2px solid var(--gold);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .stats-band {
    background: linear-gradient(180deg, var(--cream) 0%, var(--cream-deep) 50%, var(--cream) 100%);
    padding-block: clamp(3.25rem, 6vw, 5rem);
  }
  .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; text-align: center; }
  .stat { display: flex; flex-direction: column; gap: 0.7rem; position: relative; }
  .stat:not(:last-child)::after { content: ''; position: absolute; right: -1rem; top: 18%; height: 64%; width: 1px; background: var(--line); }
  .stat-num { font-family: var(--font-display); font-size: clamp(2.2rem, 1.7rem + 2vw, 3.2rem); color: var(--gold); line-height: 1; }
  .stat-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

  @media (max-width: 880px) {
    .bio-media { max-width: 460px; margin: 0 auto 1.5rem; }
  }
  @media (max-width: 680px) {
    .stats-grid { grid-template-columns: 1fr; gap: 0; }
    .stat:not(:last-child)::after { display: none; }
    .stat:not(:last-child) { padding-bottom: 1.75rem; margin-bottom: 1.75rem; border-bottom: 1px solid var(--line); }
  }
</style>
