---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kicker: string;
  title: string;
  titleAccent?: string;
  subtitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  objectPosition?: string;
  tint?: 'warm' | 'cool';
  portrait?: ImageMetadata;
  portraitAlt?: string;
  portraitPosition?: string;
}

const {
  kicker, title, titleAccent, subtitle,
  image, imageAlt = '', objectPosition = '50% 55%', tint = 'warm',
  portrait, portraitAlt = '', portraitPosition = '50% 22%',
} = Astro.props;
---

{portrait ? (
  <section class="ph ph-portrait">
    <div class="ph-portrait-bg" aria-hidden="true"></div>
    <div class="wrap ph-portrait-grid">
      <div class="ph-portrait-text">
        <p class="kicker ph-en" style="--d:0ms">{kicker}</p>
        <h1 class="ph-title-cream ph-en" style="--d:90ms">{title}{titleAccent && <>{' '}<em>{titleAccent}</em></>}</h1>
        <span class="rule ph-en-rule" style="--d:200ms"></span>
        {subtitle && <p class="ph-sub-cream ph-en rich" style="--d:280ms" set:html={subtitle} />}
      </div>
      <div class="ph-portrait-media ph-en-media" style="--d:160ms">
        <div class="ph-portrait-frame">
          <Image src={portrait} alt={portraitAlt} widths={[420, 640, 820]} sizes="(max-width: 880px) 80vw, 440px" quality={80} format="webp" fetchpriority="high" loading="eager" style={`object-position:${portraitPosition}`} />
        </div>
        <span class="ph-portrait-deco ph-portrait-deco-br" aria-hidden="true"></span>
        <span class="ph-portrait-deco ph-portrait-deco-tl" aria-hidden="true"></span>
      </div>
    </div>
  </section>
) : image ? (
  <section class:list={['ph', 'ph-image', `tint-${tint}`]}>
    <div class="ph-media">
      <Image src={image} alt={imageAlt} widths={[768, 1280, 1920]} sizes="100vw" quality={72} format="webp" fetchpriority="high" loading="eager" style={`object-position:${objectPosition}`} />
    </div>
    <div class="ph-scrim"></div>
    <div class="wrap ph-inner">
      <p class="kicker ph-kicker ph-en" style="--d:120ms">{kicker}</p>
      <h1 class="ph-title ph-en" style="--d:220ms">{title}{titleAccent && <>{' '}<em>{titleAccent}</em></>}</h1>
      {subtitle && <p class="ph-sub ph-en rich" style="--d:360ms" set:html={subtitle} />}
    </div>
  </section>
) : (
  <section class="ph ph-cream">
    <div class="wrap wrap-narrow ph-inner">
      <p class="kicker ph-en" style="--d:0ms">{kicker}</p>
      <h1 class="ph-title-cream ph-en" style="--d:90ms">{title}{titleAccent && <>{' '}<em>{titleAccent}</em></>}</h1>
      <div class="ornament ph-orn ph-en" style="--d:180ms"><span>✦</span></div>
      {subtitle && <p class="ph-sub-cream ph-en rich" style="--d:250ms" set:html={subtitle} />}
    </div>
  </section>
)}

<style>
  .ph { position: relative; }

  /* Entrance animation (runs on load + after each View Transition) */
  .ph-en { opacity: 0; animation: ph-up 0.95s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) forwards; }
  .ph-en-rule { transform: scaleX(0); transform-origin: left; animation: ph-draw 0.9s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) forwards; }
  .ph-en-media { opacity: 0; animation: ph-up 1.1s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) forwards; }
  @keyframes ph-up { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes ph-draw { to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) {
    .ph-en, .ph-en-media { opacity: 1; animation: none; }
    .ph-en-rule { transform: scaleX(1); animation: none; }
  }

  /* Image variant */
  .ph-image {
    min-height: 64vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
    padding-bottom: clamp(3rem, 6vw, 5rem);
    padding-top: 120px;
  }
  .ph-media { position: absolute; inset: 0; z-index: -2; }
  .ph-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ph-scrim {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, hsl(27 34% 11% / 0.62) 0%, hsl(28 30% 14% / 0.32) 42%, hsl(26 30% 8% / 0.78) 100%),
      linear-gradient(0deg, var(--cream) 0%, transparent 16%);
  }
  .ph-image.tint-warm::after {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    background: hsl(32 50% 24% / 0.28);
    mix-blend-mode: multiply;
  }
  .ph-image.tint-cool .ph-scrim {
    background:
      linear-gradient(180deg, hsl(205 48% 10% / 0.5) 0%, transparent 24%, transparent 48%, hsl(205 52% 9% / 0.58) 100%),
      linear-gradient(0deg, var(--cream) 0%, transparent 16%);
  }
  .ph-image .ph-inner { color: var(--cream); max-width: 820px; }
  .ph-kicker { color: hsl(40 40% 92% / 0.85); margin-bottom: 1.1rem; }
  .ph-title { color: var(--cream); font-size: clamp(2.5rem, 1.8rem + 4vw, 4.75rem); line-height: 1.04; letter-spacing: -0.015em; font-weight: 500; }
  .ph-title em { font-style: italic; color: hsl(38 55% 78%); }
  .ph-sub { margin-top: 1.4rem; font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem); font-weight: 300; color: hsl(40 40% 94% / 0.92); max-width: 56ch; }
  .ph-sub.rich :global(em) { color: hsl(38 55% 80%); font-style: italic; }
  .ph-sub.rich :global(strong) { color: var(--cream); font-weight: 600; }

  /* Cream editorial variant */
  .ph-cream {
    text-align: center;
    padding-top: clamp(9rem, 7rem + 6vw, 12rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    background: radial-gradient(120% 80% at 50% 0%, var(--cream-deep), var(--cream) 65%);
  }
  .ph-cream .kicker { margin-bottom: 1.1rem; }
  .ph-title-cream { font-size: clamp(2.4rem, 1.7rem + 3.4vw, 4.25rem); line-height: 1.06; letter-spacing: -0.015em; font-weight: 500; }
  .ph-title-cream em { font-style: italic; color: var(--gold); }
  .ph-orn { max-width: 90px; margin: 1.8rem auto 0; }
  .ph-sub-cream { margin-top: 1.6rem; font-size: clamp(1.05rem, 1rem + 0.4vw, 1.2rem); color: var(--muted); max-width: 54ch; margin-inline: auto; }
  .ph-sub-cream.rich :global(em) { color: var(--gold); font-style: italic; }
  .ph-sub-cream.rich :global(strong) { color: var(--ink); font-weight: 700; }

  /* Portrait split variant (Angela beside the headline) */
  .ph-portrait {
    position: relative;
    overflow: hidden;
    padding-top: clamp(7.5rem, 6rem + 6vw, 10.5rem);
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }
  .ph-portrait-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(80% 70% at 88% 30%, hsl(36 40% 88% / 0.7), transparent 60%),
      linear-gradient(180deg, var(--cream-deep) 0%, var(--cream) 70%);
  }
  .ph-portrait-grid {
    display: grid;
    grid-template-columns: 1fr 0.78fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .ph-portrait-text .kicker { margin-bottom: 1.1rem; }
  .ph-portrait-text .rule { margin: 1.6rem 0; }
  .ph-portrait-text .ph-title-cream { font-size: clamp(2.4rem, 1.7rem + 3vw, 4rem); }
  .ph-portrait-text .ph-sub-cream { margin-inline: 0; max-width: 46ch; }
  .ph-portrait-media { position: relative; }
  .ph-portrait-frame { overflow: hidden; border-radius: 4px; box-shadow: var(--shadow-lift); aspect-ratio: 4 / 5; }
  .ph-portrait-frame :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .ph-portrait-deco { position: absolute; width: 84px; height: 84px; border: 1px solid var(--gold); opacity: 0.55; }
  .ph-portrait-deco-br { bottom: -15px; right: -15px; border-left: 0; border-top: 0; }
  .ph-portrait-deco-tl { top: -15px; left: -15px; border-right: 0; border-bottom: 0; }

  @media (max-width: 880px) {
    .ph-portrait-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .ph-portrait-media { max-width: 360px; order: -1; }
  }
</style>
