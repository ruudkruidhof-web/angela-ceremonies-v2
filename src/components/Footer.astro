---
import site from '../content/site.json';
const year = 2026;
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <p class="brand-name">Angela Ceremonies</p>
      <p class="footer-tag">Persoonlijke trouwceremonies door {site.persoon}. Trouwambtenaar (BABS) en ceremoniespreker in {site.stad}, werkzaam door heel Nederland.</p>
      <div class="ornament footer-orn"><span>✦</span></div>
    </div>

    <nav class="footer-col" aria-label="Pagina's">
      <p class="footer-head">Pagina's</p>
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="footer-col">
      <p class="footer-head">Contact</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${site.telefoonLink}`}>{site.telefoon}</a>
      <a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a>
      <p class="footer-city">{site.stad}</p>
    </div>
  </div>

  <div class="wrap footer-base">
    <p>&copy; {year} Angela Ceremonies. Alle rechten voorbehouden.</p>
    <p><a href="/privacy">Privacyverklaring</a> · <a href="https://haagsebrandmerk.nl">Website door Haagse Brandmerk</a></p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: hsl(40 30% 86%);
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 2rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--cream);
    margin-bottom: 1rem;
  }
  .footer-tag {
    font-size: 0.92rem;
    line-height: 1.7;
    color: hsl(40 18% 72%);
    max-width: 40ch;
  }
  .footer-orn { max-width: 200px; margin-top: 1.75rem; color: var(--gold-soft); --line: hsl(40 20% 40%); }
  .footer-col { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-head {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-soft);
    margin-bottom: 0.5rem;
  }
  .footer-col a {
    color: hsl(40 24% 80%);
    text-decoration: none;
    font-size: 0.95rem;
    width: fit-content;
    transition: color 0.3s ease;
  }
  .footer-col a:hover { color: var(--cream); }
  .footer-city { font-size: 0.95rem; color: hsl(40 18% 64%); }
  .footer-base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 2rem;
    border-top: 1px solid hsl(40 15% 28%);
    font-size: 0.78rem;
    color: hsl(40 14% 58%);
  }
  .footer-base a { color: inherit; text-decoration: none; transition: color 0.3s ease; }
  .footer-base a:hover { color: var(--cream); }
  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
