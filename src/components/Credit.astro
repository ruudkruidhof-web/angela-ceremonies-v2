---
interface Props {
  naam: string;
}
const { naam } = Astro.props;
---

<span class="credit">Foto {naam}</span>

<style>
  .credit {
    position: absolute;
    right: 0.75rem;
    bottom: 0.6rem;
    z-index: 2;
    font-family: var(--font-body);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: hsl(40 40% 97% / 0.86);
    text-shadow: 0 1px 8px hsl(26 40% 6% / 0.7);
    pointer-events: none;
  }
</style>
